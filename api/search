ocale":"en"},"8125":{"id":"/en/docs/development-architecture-96","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Server (`rvc-next webui`)","locale":"en"},"8126":{"id":"/en/docs/development-architecture-97","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Command line","locale":"en"},"8127":{"id":"/en/docs/development-architecture-98","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Entry point","locale":"en"},"8128":{"id":"/en/docs/development-architecture-99","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`build_services(start_background=True)`, stored on `app.state.services`, accessed by routes through `ServicesDep`","locale":"en"},"8129":{"id":"/en/docs/development-architecture-100","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"The `open_services()` context manager in `cli/output.py` constructs services once per command and closes them afterwards","locale":"en"},"8130":{"id":"/en/docs/development-architecture-101","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Background","locale":"en"},"8131":{"id":"/en/docs/development-architecture-102","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Removes expired uploads and outputs older than `convert.keep_outputs_days` (`audio.cleanup()`), `compute.start()` (idle unloading), `jobs.start()` (scheduler thread), `live.start_background()`","locale":"en"},"8132":{"id":"/en/docs/development-architecture-103","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"None","locale":"en"},"8133":{"id":"/en/docs/development-architecture-104","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Jobs","locale":"en"},"8134":{"id":"/en/docs/development-architecture-105","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`jobs.submit()` queues jobs; the scheduler executes them as resources allow","locale":"en"},"8135":{"id":"/en/docs/development-architecture-106","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`jobs.run_now()` executes in the foreground on the calling thread; Ctrl+C cancels","locale":"en"},"8136":{"id":"/en/docs/development-architecture-107","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Tests build fully isolated services using `environ=` (instead of `os.environ`), `transport=` (instead of the network) and `data_dir=` (`make_services` in `tests/conftest.py`). `Services.close()` closes live, jobs, compute, http and the database in that order.","locale":"en"},"8137":{"id":"/en/docs/development-architecture-108","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Work","locale":"en"},"8138":{"id":"/en/docs/development-architecture-109","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Where it runs","locale":"en"},"8139":{"id":"/en/docs/development-architecture-110","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Reason","locale":"en"},"8140":{"id":"/en/docs/development-architecture-111","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"HTTP and socket.io","locale":"en"},"8141":{"id":"/en/docs/development-architecture-112","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Server process event loop; routes involving disk and database access use plain `def` and run in a thread pool","locale":"en"},"8142":{"id":"/en/docs/development-architecture-113","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"—","locale":"en"},"8143":{"id":"/en/docs/development-architecture-114","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Offline conversion, merging, extraction, downloads, etc.","locale":"en"},"8144":{"id":"/en/docs/development-architecture-115","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Job thread in the server (or CLI) process, with a `CancelToken`","locale":"en"},"8145":{"id":"/en/docs/development-architecture-116","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"HuBERT, F0 models and recently used voices remain cached, so the second file starts immediately","locale":"en"},"8146":{"id":"/en/docs/development-architecture-117","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Vocal separation","locale":"en"},"8147":{"id":"/en/docs/development-architecture-118","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"One `workers.separate` subprocess per job","locale":"en"},"8148":{"id":"/en/docs/development-architecture-119","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"PyMSS has no internal cancellation mechanism, so cancellation requires killing the process; all GPU memory is returned when it exits. Follows the original's `tools/pymss_webui.py` design","locale":"en"},"8149":{"id":"/en/docs/development-architecture-120","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Training stages","locale":"en"},"8150":{"id":"/en/docs/development-architecture-121","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"One `workers.train` subprocess per stage","locale":"en"},"8151":{"id":"/en/docs/development-architecture-122","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Allows hard cancellation and a clean CUDA context; DDP also needs its own processes","locale":"en"},"8152":{"id":"/en/docs/development-architecture-123","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Live voice conversion","locale":"en"},"8153":{"id":"/en/docs/development-architecture-124","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"One persistent `workers.live` subprocess","locale":"en"},"8154":{"id":"/en/docs/development-architecture-125","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"It owns the audio devices and real-time threads, which need isolation from the server's event loop, GIL contention and possible crashes","locale":"en"},"8155":{"id":"/en/docs/development-architecture-126","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Device enumeration","locale":"en"},"8156":{"id":"/en/docs/development-architecture-127","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Short-lived `workers.devices` subprocess","locale":"en"},"8157":{"id":"/en/docs/development-architecture-128","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#process-model","content":"Re-enumerating PortAudio in a process with an open stream disrupts it; the original refreshes the device list by calling private `sd._terminate()` and stopping conversion","locale":"en"},"8158":{"id":"/en/docs/development-architecture-129","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"`workers.train`, `workers.separate` and `workers.devices` follow the same conventions, derived from the event protocol in the original's `tools/pymss_webui.py`:","locale":"en"},"8159":{"id":"/en/docs/development-architecture-130","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"Core writes the request to a JSON file and starts the worker with `sys.executable -m <module> <request.json>` (`core/process.py`: its own process group, merged stdout and stderr, `PYTHONUNBUFFERED=1`). The original's `--pycmd` option is therefore no longer needed.","locale":"en"},"8160":{"id":"/en/docs/development-architecture-131","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"Worker entry points go through `run_worker()` in `workers/base.py`: it duplicates the real stdout exclusively for events, then redirects file descriptor 1 to stderr. Incidental `print` calls in libraries therefore become log text and cannot be mistaken for events.","locale":"en"},"8161":{"id":"/en/docs/development-architecture-132","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"Events are JSON lines prefixed with `@rvc ` (`protocol/jsonl.py`), with types in `protocol/messages.py`: `progress`, `step`, `log`, `metric`, `output`, `result`, `error`. Lines without the prefix are always treated as `info` logs.","locale":"en"},"8162":{"id":"/en/docs/development-architecture-133","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"Failures become `error` events: `MissingAssetError` → `asset_missing` (`detail.assets`), `ModelFormatError` → `invalid_model`, out of GPU memory → `compute_unavailable` with `detail.reason = \"out_of_memory\"`, everything else → `internal_error`; the full stack trace is sent separately as an `error` log. Core reconstructs the corresponding domain error with `worker_error()` in `core/engine_errors.py`.","locale":"en"},"8163":{"id":"/en/docs/development-architecture-134","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"Exit codes: 0 for success; `EXIT_CANCELLED = 130` for cancellation (SIGTERM also maps to it); `EXIT_RETRY = 75` requests a retry in a new process (separation on DirectML tries fp16 first, then fp32 if it fails).","locale":"en"},"8164":{"id":"/en/docs/development-architecture-135","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"Cancellation kills the entire process tree (`kill_process_tree`, ported from the original's `tools/process_utils.py`).","locale":"en"},"8165":{"id":"/en/docs/development-architecture-136","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#worker-protocol","content":"`workers.live` is the exception: it persists and needs two-way communication, so it uses `multiprocessing.connection`. Core's `LiveSupervisor` opens a `Listener` with a random authkey and writes its address into the request file; the two sides then exchange JSON messages defined in `protocol/live.py` (`Start`, `UpdateVoice`, `SetDevices`… and `State`, `Stats`, `DeviceLost`, `Log`). See Core services and Engine.","locale":"en"},"8166":{"id":"/en/docs/development-architecture-137","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#a-requests-path","content":"For example, clicking “Convert” in the browser:","locale":"en"},"8167":{"id":"/en/docs/development-architecture-138","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#a-requests-path","content":"Key points:","locale":"en"},"8168":{"id":"/en/docs/development-architecture-139","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#a-requests-path","content":"REST is the source of truth; sockets only push from server to client. After reconnecting, the client refetches active jobs, Live state and visible lists.","locale":"en"},"8169":{"id":"/en/docs/development-architecture-140","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#a-requests-path","content":"Job requests are stored as JSON in the database. Factories registered by `kind` reconstruct `JobSpec` from the request, so **Retry** still works after a server restart.","locale":"en"},"8170":{"id":"/en/docs/development-architecture-141","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#a-requests-path","content":"Routes validate when the request arrives (for example, missing RMVPE immediately returns 409 `asset_missing`, with a download offered in place in the UI), instead of letting a queued job fail later.","locale":"en"},"8171":{"id":"/en/docs/development-architecture-142","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`core/errors.py` defines the complete error vocabulary. Each class carries `code`, `http_status` and `exit_code`, translated mechanically by both interfaces: the API turns any `RvcNextError` into `{\"code\", \"message\", \"detail\"}` (`api/errors.py`), and the CLI turns it into an exit code.","locale":"en"},"8172":{"id":"/en/docs/development-architecture-143","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"Exception","locale":"en"},"8173":{"id":"/en/docs/development-architecture-144","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`code`","locale":"en"},"8174":{"id":"/en/docs/development-architecture-145","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"HTTP","locale":"en"},"8175":{"id":"/en/docs/development-architecture-146","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"Exit code","locale":"en"},"8176":{"id":"/en/docs/development-architecture-147","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"When raised","locale":"en"},"8177":{"id":"/en/docs/development-architecture-148","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`NotFoundError`","locale":"en"},"8178":{"id":"/en/docs/development-architecture-149","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`not_found`","locale":"en"},"8179":{"id":"/en/docs/development-architecture-150","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"404","locale":"en"},"8180":{"id":"/en/docs/development-architecture-151","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"2","locale":"en"},"8181":{"id":"/en/docs/development-architecture-152","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"Voice, job, file or experiment does not exist","locale":"en"},"8182":{"id":"/en/docs/development-architecture-153","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`ConflictError`","locale":"en"},"8183":{"id":"/en/docs/development-architecture-154","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"`conflict`","locale":"en"},"8184":{"id":"/en/docs/development-architecture-155","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors-and-exit-codes","content":"409","locale":"en"},"8185":{"id":"/en/docs/development-architecture-156","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architectu