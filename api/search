cs/guide-separate-52","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Vocals + Remove reverb","locale":"en"},"11537":{"id":"/en/docs/guide-separate-53","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"**Lead vocal, clean**  (chain)","locale":"en"},"11538":{"id":"/en/docs/guide-separate-54","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`lead-clean`","locale":"en"},"11539":{"id":"/en/docs/guide-separate-55","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Separate vocals, extract lead vocals, then remove reverb: produce clean lead vocals, backing vocals and accompaniment","locale":"en"},"11540":{"id":"/en/docs/guide-separate-56","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`main_vocal`, `instrumental`, `off_vocal`, `reverb`","locale":"en"},"11541":{"id":"/en/docs/guide-separate-57","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Vocals + Lead vocal + Remove reverb","locale":"en"},"11542":{"id":"/en/docs/guide-separate-58","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Stem names mean:","locale":"en"},"11543":{"id":"/en/docs/guide-separate-59","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Stem","locale":"en"},"11544":{"id":"/en/docs/guide-separate-60","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Meaning","locale":"en"},"11545":{"id":"/en/docs/guide-separate-61","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`vocals`","locale":"en"},"11546":{"id":"/en/docs/guide-separate-62","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Vocals (dry, dereverberated vocals in chain presets)","locale":"en"},"11547":{"id":"/en/docs/guide-separate-63","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`instrumental`","locale":"en"},"11548":{"id":"/en/docs/guide-separate-64","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Accompaniment","locale":"en"},"11549":{"id":"/en/docs/guide-separate-65","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`noreverb` / `reverb`","locale":"en"},"11550":{"id":"/en/docs/guide-separate-66","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Audio with reverb removed / separated reverb","locale":"en"},"11551":{"id":"/en/docs/guide-separate-67","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`main_vocal` / `off_vocal`","locale":"en"},"11552":{"id":"/en/docs/guide-separate-68","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Lead vocals / backing vocals","locale":"en"},"11553":{"id":"/en/docs/guide-separate-69","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Presets labeled **chain** run multiple models sequentially: each step processes the previous step's primary stem (for example, **Vocals, clean** extracts vocals, then removes reverb from them). Each stem is output only once.","locale":"en"},"11554":{"id":"/en/docs/guide-separate-70","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#how-to-choose","content":"**Ordinary song conversion**: use **Vocals**. If accompaniment remains in the separated vocals, try **Vocals, aggressive**.","locale":"en"},"11555":{"id":"/en/docs/guide-separate-71","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#how-to-choose","content":"**Vocals with heavy reverb**: use **Vocals, clean** to get dry vocals directly, which usually convert better.","locale":"en"},"11556":{"id":"/en/docs/guide-separate-72","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#how-to-choose","content":"**Songs with backing vocals**: use **Lead vocal, clean** to keep only the lead for conversion, avoiding conversion of the backing vocals along with it.","locale":"en"},"11557":{"id":"/en/docs/guide-separate-73","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#how-to-choose","content":"**Otherwise clean vocals with reverb**: use **Remove reverb** or **Remove reverb, aggressive** directly.","locale":"en"},"11558":{"id":"/en/docs/guide-separate-74","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#how-to-choose","content":"Use **Lead vocal** on vocals rather than a full song: extract vocals with **Vocals** first, choose **Use as input** on the vocal result, then separate again with **Lead vocal**. Or use the **Lead vocal, clean** chain directly.","locale":"en"},"11559":{"id":"/en/docs/guide-separate-75","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#imported-separation-models","content":"You can also import your own separation models (checkpoint and `.yaml` configuration) in **Models › Separation models**. Each imported model becomes a single-step preset here, with an **imported** label on its card. See Model management for import instructions.","locale":"en"},"11560":{"id":"/en/docs/guide-separate-76","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#download-separation-models","content":"Each built-in preset needs one or more separation models, about 305 MB each (the two Vocals models) or about 436 MB each (the other three). To get them:","locale":"en"},"11561":{"id":"/en/docs/guide-separate-77","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#download-separation-models","content":"After choosing a preset, if its models are not downloaded, the **Separate** button in the action bar is replaced by a notice such as “**Needs Separation: Vocals**” and a **Download** button. Click to download.","locale":"en"},"11562":{"id":"/en/docs/guide-separate-78","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#download-separation-models","content":"**Built-in** in **Models › Separation models** lists all five built-in models, which you can **Download** or delete individually;","locale":"en"},"11563":{"id":"/en/docs/guide-separate-79","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#download-separation-models","content":"In the **Separation** group under **Models › Assets**, click **Download everything for Separation** to download them all at once.","locale":"en"},"11564":{"id":"/en/docs/guide-separate-80","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#download-separation-models","content":"Separation models are stored in `pymss_weights/` within the assets folder, matching the original RVC's layout. If you point the assets folder to the original RVC's `assets/` in settings, already downloaded models with matching names can be used directly; see Migrating from the original RVC.","locale":"en"},"11565":{"id":"/en/docs/guide-separate-81","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#jobs","content":"Each click on **Separate** creates **one** job for all current inputs, with a title such as `Separate song.flac · Vocals` (or `Separate song.flac and 2 more · Vocals` for multiple inputs). Each input is one step. Separation runs in a separate worker process; you can **Cancel** at any time, **Retry** after failure and click **Log** to view the process.","locale":"en"},"11566":{"id":"/en/docs/guide-separate-82","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#jobs","content":"Separation uses the device selected in **Settings › Compute**. CPU also works, but RoFormer models are slower on CPU, so long songs require patience.","locale":"en"},"11567":{"id":"/en/docs/guide-separate-83","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#jobs","content":"On DirectML, if a model fails in half precision, RVC Next automatically reruns it in fp32 (logging `Retrying in fp32`).","locale":"en"},"11568":{"id":"/en/docs/guide-separate-84","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#results","content":"Separated stems appear in **Results**, **grouped by source file**. Each group has the source filename as its title, followed by its stems, each labeled **stem** with a stem name (such as `vocals`). See Interface overview › Results list for shared actions such as playback, comparison and downloads.","locale":"en"},"11569":{"id":"/en/docs/guide-separate-85","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#results","content":"Two actions specific to this page appear in each stem's **More actions** (⋮) menu:","locale":"en"},"11570":{"id":"/en/docs/guide-separate-86","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#results","content":"**Convert this**: add the stem to **Convert**'s inputs and switch to **Convert**. Choose a voice and you are ready to convert.","locale":"en"},"11571":{"id":"/en/docs/guide-separate-87","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#results","content":"**Use as input**: add the stem back to this page's inputs for another separation preset, such as running **Lead vocal** on `vocals`.","locale":"en"},"11572":{"id":"/en/docs/guide-separate-88","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#results","content":"Results are saved in `outputs/<date>/<job id>/` in the data folder, with filenames:","locale":"en"},"11573":{"id":"/en/docs/guide-separate-89","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#results","content":"For example, separating `song.flac` with **Vocals** to FLAC produces `song.vocals.flac` and `song.instrumental.flac`. If a matching filename exists, a number is added, such as `song.vocals-2.flac`, without overwriting.","locale":"en"},"11574":{"id":"/en/docs/guide-separate-90","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#command-line","content":"See Command reference for all options.","locale":"en"},"11575":{"id":"/en/docs/guide-settings","page_id":"/en/docs/guide-settings","type":"page","content":"Settings","breadcrumbs":["RVC Next Documentation","Guides"],"tags":[],"url":"/en/docs/guide-settings","locale":"en"},"11576":{"id":"/en/docs/guide-settings-0","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings","content":"The Settings page brings together all rvc-next options in eight tabs: General, Compute, Audio, Storage, Downloads, Training defaults, Appearance and About.","locale":"en"},"11577":{"id":"/en/docs/guide-settings-1","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#where-settings-are-saved","content":"Where settings are saved","locale":"en"},"11578":{"id":"/en/docs/guide-settings-2","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#general","content":"General","locale":"en"},"11579":{"id":"/en/docs/guide-settings-3","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#access-token","content":"Access token","locale":"en"},"11580":{"id":"/en/docs/guide-settings-4","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#compute","content":"Compute","locale":"en"},"11581":{"id":"/en/docs/guide-settings-5","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#audio","content":"Audio","locale":"en"},"11582":{"id":"/en/docs/guide-settings-6","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#storage","content":"Storage","locale":"en"},"11583":{"id":"/en/docs/guide-settings-7","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#folders","content":"Folders","locale":"en"},"11584":{"id":"/en/docs/guide-settings-8","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#folders-the-browser-may-open","content":"Folders the browser may open","locale":"en"},"11585":{"id":"/en/docs/guide-settings-9","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#result-retention","content":"Result retention","locale":"en"},"11586":{"id":"/en/docs/guide-settings-10","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#downloads","content":"Downloads","locale":"en"},"11587":{"id":"/en/docs/guide-settings-11","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#training-defaults","content":"Training defaults","locale":"en"},"11588":{"id":"/en/docs/guide-settings-12","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#appearance","content":"Appearance","locale":"en"},"11589":{"id":"/en/docs/guide-settings-13","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#about","content":"About","locale":"en"},"11590":{"id":"/en/docs/guide-settings-14","page_id":"/en/docs/guide-settings","type":"heading","tags":[],"url":"/en/docs/guide-settings#change-settings-from-the-command-line","content":"Change settings from the command line","locale":"en"},"11591":{"id":"/en/docs/guide-settings-15","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings","content":"Most options save immediately when changed, showing **Settings saved**. Folders in **Storage** require you to click **Save**. A few options (server address and port) take effect the next time the server starts, as noted in the UI.","locale":"en"},"11592":{"id":"/en/docs/guide-settings-16","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#where-settings-are-saved","content":"Server settings are stored in `settings.toml` in the data folder. The default data folder is:","locale":"en"},"11593":{"id":"/en/docs/guide-settings-17","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#where-settings-are-saved","content":"Windows: `%APPDATA%\\rvc-next`","locale":"en"},"11594":{"id":"/en/docs/guide-settings-18","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#where-settings-are-saved","content":"macOS: `~/Library/Application Support/rvc-next`","locale":"en"},"11595":{"id":"/en/docs/guide-settings-19","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#where-settings-are-saved","content":"Linux: `~/.local/share/rvc-next` (or `$XDG_DATA_HOME/rvc-next`)","locale":"en"},"11596":{"id":"/en/docs/guide-settings-20","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#where-settings-are-saved","content":"Set a different location with `RVC_NEXT_DATA_DIR` or `rvc-next webui --data-dir`. `rvc-next config path` prints the settings file path.","locale":"en"},"11597":{"id":"/en/docs/guide-settings-21","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#where-settings-are-saved","content":"**Appearance** and **General › Language** are UI preferences. They are stored on the server (so they are the same in another browser), with a local browser copy, and are not written to `settings.toml`.","locale":"en"},"11598":{"id":"/en/docs/guide-settings-22","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#where-settings-are-saved","content":"Every setting can be overridden by an environment variable in the form `RVC_NEXT_<GROUP>__<FIELD>`, for example `RVC_NEXT_SERVER__PORT=8000` or `RVC_NEXT_PATHS__ASSETS_DIR=D:\\rvc-assets`. Environment variables take precedence over `settings.toml`. The UI shows the effective value; edits in the UI write to `settings.toml`, but the environment variable's value stays effective while it is set. Folders pinned by environment variables in **Storage** are marked **Set by an environment variable**. See Configuration and environment variables for the full list, or run `rvc-next env`.","locale":"en"},"11599":{"id":"/en/docs/guide-settings-23","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"Option","locale":"en"},"11600":{"id":"/en/docs/guide-settings-24","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"Default","locale":"en"},"11601":{"id":"/en/docs/guide-settings-25","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"Description","locale":"en"},"11602":{"id":"/en/docs/guide-settings-26","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"**Language**","locale":"en"},"11603":{"id":"/en/docs/guide-settings-27","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"**Auto (…)**","locale":"en"},"11604":{"id":"/en/docs/guide-settings-28","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"UI language: follow the system automatically, or choose English / Simplified Chinese. Takes effect immediately","locale":"en"},"11605":{"id":"/en/docs/guide-settings-29","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"**Open the browser when the server starts**","locale":"en"},"11606":{"id":"/en/docs/guide-settings-30","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"On","locale":"en"},"11607":{"id":"/en/docs/guide-settings-31","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"Opens the page automatically when running `rvc-next webui`. The command-line `--open/--no-open` temporarily overrides this","locale":"en"},"11608":{"id":"/en/docs/guide-settings-32","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"**Server address**","locale":"en"},"11609":{"id":"/en/docs/guide-settings-33","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"`127.0.0.1`","locale":"en"},"11610":{"id":"/en/docs/guide-settings-34","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"Address the server listens on. **Takes effect the next time the server starts.**","locale":"en"},"11611":{"id":"/en/docs/guide-settings-35","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"**Port**","locale":"en"},"11612":{"id":"/en/docs/guide-settings-36","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"`7868`","locale":"en"},"11613":{"id":"/en/docs/guide-settings-37","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"Server port; takes effect on the next start. If occupied, the next port is tried automatically","locale":"en"},"11614":{"id":"/en/docs/guide-settings-38","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#access-token","content":"An access token is an optional layer of protection. Once set, every request to the server API (including those made by the web UI itself) must include it.","locale":"en"},"11615":{"id":"/en/docs/guide-settings-39","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#access-token","content":"Enter a sufficiently long random string in **Access token**.","locale":"en"},"11616":{"id":"/en/docs/guide-settings-40","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#access-token","content":"Click **Set token**. The label on the left becomes **An access token is set**.","locale":"en"},"11617":{"id":"/en/docs/guide-settings-41","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#access-token","content":"The browser then opens the **Access token** dialog (**This server asks for its access token.**). Enter the same token to continue.","locale":"en"},"11618":{"id":"/en/docs/guide-settings-42","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#access-token","content":"To remove it, click **Clear token**. The token is not displayed again after saving.","locale":"en"},"11619":{"id":"/en/docs/guide-settings-43","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#access-token","content":"The default address `127.0.0.1` allows only local access. After you change **Server address** to `0.0.0.0` or a LAN IP, no access token is needed: anyone who can connect can use every feature (browsing the server folders allowed below included). Do this only on a trusted network, add protection of your own such as a firewall or a VPN, or set an access token. See Remote access and security.","locale":"en"},"11620":{"id":"/en/docs/guide-settings-44","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Option","locale":"en"},"11621":{"id":"/en/docs/guide-settings-45","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Default","locale":"en"},"11622":{"id":"/en/docs/guide-settings-46","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Description","locale":"en"},"11623":{"id":"/en/docs/guide-settings-47","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**Device**","locale":"en"},"11624":{"id":"/en/docs/guide-settings-48","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**Automatic**","locale":"en"},"11625":{"id":"/en/docs/guide-settings-49","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Device used to run models. The dropdown lists detected devices and their GPU memory; unsupported devices are marked ✕. Automatic selects the most suitable NVIDIA GPU (highest compute capability, most GPU memory), then tries DirectML, then CPU. You can also choose a specific GPU (`cuda:N`), DirectML, CPU or experimental Apple MPS (`mps`)","locale":"en"},"11626":{"id":"/en/docs/guide-settings-50","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**Precision**","locale":"en"},"11627":{"id":"/en/docs/guide-settings-51","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**Automatic**","locale":"en"},"11628":{"id":"/en/docs/guide-settings-52","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**Automatic** / **fp32** / **fp16**. Automatic uses half precision (fp16) on supported GPUs, otherwise fp32, following the original's rules","locale":"en"},"11629":{"id":"/en/docs/guide-settings-53","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**CUDA Graph for conversion**","locale":"en"},"11630":{"id":"/en/docs/guide-settings-54","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Off","locale":"en"},"11631":{"id":"/en/docs/guide-settings-55","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Uses CUDA Graph to reduce GPU scheduling overhead in offline conversion","locale":"en"},"11632":{"id":"/en/docs/guide-settings-56","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**CUDA Graph for Live**","locale":"en"},"11633":{"id":"/en/docs/guide-settings-57","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"On","locale":"en"},"11634":{"id":"/en/docs/guide-settings-58","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Uses CUDA Graph for live voice conversion","locale":"en"},"11635":{"id":"/en/docs/guide-settings-59","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**Unload models after idle minutes (0: never)**","locale":"en"},"11636":{"id":"/en/docs/guide-settings-60","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"10","locale":"en"},"11637":{"id":"/en/docs/guide-settings-61","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Automatically unloads models after this idle period to free GPU memory. 0 disables automatic unloading","locale":"en"},"11638":{"id":"/en/docs/guide-settings-62","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"**GPU jobs at once**","locale":"en"},"11639":{"id":"/en/docs/guide-settings-63","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"1","locale":"en"},"11640":{"id":"/en/docs/guide-settings-64","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"1–16. Increase this with enough GPU memory to run several conversion/separation jobs in parallel","locale":"en"},"11641":{"id":"/en/docs/guide-settings-65","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"The table below lists each device's ID, name, precision that will be used, and the reason if it cannot be used.","locale":"en"},"11642":{"id":"/en/docs/guide-settings-66","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#compute","content":"Changing device, precision or **CUDA Graph for conversion** unloads the server's loaded models; the next job loads them with the new settings. Live voice conversion runs in its own background process and reads these settings when that process starts. If Live does not reflect a change, restart the server.","locale":"en"},"11643":{"id":"/en/docs/guide-settings-67","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"The device panel here is identical to the one on **Live**; both edit the same settings. See “Audio devices” in Live for instructions.","locale":"en"},"11644":{"id":"/en/docs/guide-settings-68","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"Option","locale":"en"},"11645":{"id":"/en/docs/guide-settings-69","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"Default","locale":"en"},"11646":{"id":"/en/docs/guide-settings-70","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"Description","locale":"en"},"11647":{"id":"/en/docs/guide-settings-71","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"**Enable ASIO drivers (Windows)**","locale":"en"},"11648":{"id":"/en/docs/guide-settings-72","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"Off","locale":"en"},"11649":{"id":"/en/docs/guide-settings-73","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"Adds ASIO drivers to the device list (requires an audio interface with an ASIO driver). After enabling it, click **Refresh devices** on **Live**","locale":"en"},"11650":{"id":"/en/docs/guide-settings-74","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"**Reconnect a lost device automatically**","locale":"en"},"11651":{"id":"/en/docs/guide-settings-75","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"On","locale":"en"},"11652":{"id":"/en/docs/guide-settings-76","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"If a device disconnects during live voice conversion, searches every 2 seconds and resumes automatically when it returns. When off, disconnection stops the session immediately","locale":"en"},"11653":{"id":"/en/docs/guide-settings-77","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"**Show the input meter while stopped**","locale":"en"},"11654":{"id":"/en/docs/guide-settings-78","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"On","locale":"en"},"11655":{"id":"/en/docs/guide-settings-79","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"While the device panel is shown, it keeps the microphone open and shows **Input level** even when Live is stopped. The microphone is released about 15 seconds after the page is closed or hidden. Turn this off if you do not want the microphone kept in use","locale":"en"},"11656":{"id":"/en/docs/guide-settings-80","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"**Record output devices as inputs (loopback)**","locale":"en"},"11657":{"id":"/en/docs/guide-settings-81","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"Off","locale":"en"},"11658":{"id":"/en/docs/guide-settings-82","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#audio","content":"Lists every output device in the **Input** menu, marked **loopback**: what that device plays (a video, a game) becomes the input. Windows records through WASAPI loopback, Linux through the PulseAudio/PipeWire monitors; macOS needs a loopback driver such as BlackHole, chosen as an ordinary input. See Record an output device. To send the converted voice *to* another program, see Use Live in other apps","locale":"en"},"11659":{"id":"/en/docs/guide-settings-83","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Option","locale":"en"},"11660":{"id":"/en/docs/guide-settings-84","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Location when empty","locale":"en"},"11661":{"id":"/en/docs/guide-settings-85","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Contents","locale":"en"},"11662":{"id":"/en/docs/guide-settings-86","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"**Voices**","locale":"en"},"11663":{"id":"/en/docs/guide-settings-87","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"`<data directory>/models`","locale":"en"},"11664":{"id":"/en/docs/guide-settings-88","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Voice library, imported base models, separation models and unassigned indexes","locale":"en"},"11665":{"id":"/en/docs/guide-settings-89","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"**Experiments**","locale":"en"},"11666":{"id":"/en/docs/guide-settings-90","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"`<data directory>/experiments`","locale":"en"},"11667":{"id":"/en/docs/guide-settings-91","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Training experiments","locale":"en"},"11668":{"id":"/en/docs/guide-settings-92","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"**Results**","locale":"en"},"11669":{"id":"/en/docs/guide-settings-93","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"`<data directory>/outputs`","locale":"en"},"11670":{"id":"/en/docs/guide-settings-94","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Conversion and separation results","locale":"en"},"11671":{"id":"/en/docs/guide-settings-95","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"**Assets**","locale":"en"},"11672":{"id":"/en/docs/guide-settings-96","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"`<data directory>/assets`","locale":"en"},"11673":{"id":"/en/docs/guide-settings-97","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Downloaded files such as HuBERT, RMVPE, base models and separation models","locale":"en"},"11674":{"id":"/en/docs/guide-settings-98","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Each field shows **Default: \\{path}** below it. Leave it empty to use the default location within the data folder.","locale":"en"},"11675":{"id":"/en/docs/guide-settings-99","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"**Assets** uses the original RVC layout, so you can point it directly at an original RVC install's `assets` folder to reuse downloaded HuBERT, RMVPE and base models without downloading them again.","locale":"en"},"11676":{"id":"/en/docs/guide-settings-100","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders","content":"Changing a folder does not move existing files automatically. To change locations, move the folder yourself first, then update the setting.","locale":"en"},"11677":{"id":"/en/docs/guide-settings-101","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders-the-browser-may-open","content":"**Folders the browser may open** controls which server locations the web UI's **Server files** and **Browse…** dialogs can access. Enter one path per line.","locale":"en"},"11678":{"id":"/en/docs/guide-settings-102","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders-the-browser-may-open","content":"When empty (default), this includes your home folder, added original RVC installs, the data folder and every drive (Windows `C:\\`, `D:\\`…) or mounted volume (macOS `/Volumes/…`; Linux `/media/<user>/…`, `/run/media/<user>/…`, `/mnt/…`). The gray placeholder lists the folders currently allowed. Entering paths restricts access to those folders.","locale":"en"},"11679":{"id":"/en/docs/guide-settings-103","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#folders-the-browser-may-open","content":"These folders apply to every browser, those on other computers included; the command line is not limited by them.","locale":"en"},"11680":{"id":"/en/docs/guide-settings-104","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#result-retention","content":"**Delete results after days (0: keep)** defaults to 0. Set a positive number to automatically delete conversion/separation results older than that many days.","locale":"en"},"11681":{"id":"/en/docs/guide-settings-105","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#result-retention","content":"After changing folders or browsable locations, click **Save** at the bottom right.","locale":"en"},"11682":{"id":"/en/docs/guide-settings-106","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#downloads","content":"Option","locale":"en"},"11683":{"id":"/en/docs/guide-settings-107","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#downloads","content":"Default","locale":"en"},"11684":{"id":"/en/docs/guide-settings-108","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#downloads","content":"Description","locale":"en"},"11685":{"id":"/en/docs/guide-settings-109","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#downloads","content":"**Model repository**","locale":"en"},"11686":{"id":"/en/docs/guide-settings-110","page