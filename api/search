cs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"function","locale":"en"},"9890":{"id":"/en/docs/development-testing-99","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"Replaces `AssetService.require` with a no-op","locale":"en"},"9891":{"id":"/en/docs/development-testing-100","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"`tiny_voice_file`","locale":"en"},"9892":{"id":"/en/docs/development-testing-101","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"function","locale":"en"},"9893":{"id":"/en/docs/development-testing-102","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"`tmp_path/src/tiny-voice.pth`","locale":"en"},"9894":{"id":"/en/docs/development-testing-103","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"`wav_file`","locale":"en"},"9895":{"id":"/en/docs/development-testing-104","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"function","locale":"en"},"9896":{"id":"/en/docs/development-testing-105","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"A 1.5-second, 22050 Hz `tone()`, written to `tmp_path/src/speech.wav`","locale":"en"},"9897":{"id":"/en/docs/development-testing-106","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#fixtures","content":"Services are built with `environ=`, never reading real `os.environ`, so developers' local `RVC_NEXT_*` settings do not leak into tests. Networking is replaced through `transport=` (`httpx.MockTransport`); download tests locally simulate resume, verification failures, and repository fallback. CLI tests use `monkeypatch.setenv` for `RVC_NEXT_DATA_DIR`, `RVC_NEXT_PATHS__ASSETS_DIR`, and `RVC_NEXT_COMPUTE__DEVICE=cpu`, because commands build their own services internally.","locale":"en"},"9898":{"id":"/en/docs/development-testing-107","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"Directory","locale":"en"},"9899":{"id":"/en/docs/development-testing-108","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"Coverage","locale":"en"},"9900":{"id":"/en/docs/development-testing-109","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"`engine/`","locale":"en"},"9901":{"id":"/en/docs/development-testing-110","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"Checkpoint read/write round trips, `emb_g` truncation during merging, G extraction; content-based index and checkpoint identification; F0 postprocessing (interpolation, pitch shift, coarse quantization); offline conversion shapes, FCPE, formant, chunking, cancellation; streaming block processing, gates, denoising, hot updates, voice switches, speakers, passthrough, latency estimates; rings, drift correction, SOLA, topology selection, device loss (fake backend); device grouping and selection resolution (recorded enumerations); training stages (keeping every slice's tail, F0, features, file lists, fingerprints), two-epoch tiny fitting and resume, gloo DDP on CPU; multi-speaker; separation presets; ported resampler and FCPE; GPU memory release and OOM detection; encoding","locale":"en"},"9902":{"id":"/en/docs/development-testing-111","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"`core/`","locale":"en"},"9903":{"id":"/en/docs/development-testing-112","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"Settings layering and validation; port selection; job scheduling, GPU capacity and Live lease, cancellation, subprocess events and process killing, `interrupted` after restart; asset download resume, verification, repository selection, speed and ETA, deletion; voice library import, legacy installations, rebuilding after database loss; import sessions and pairing rules; conversion outputs and provenance, previews, preflight checks; full training runs, export, stale markers; Live service (fake backend); GPU memory release and unloading after OOM","locale":"en"},"9904":{"id":"/en/docs/development-testing-113","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"`api/`","locale":"en"},"9905":{"id":"/en/docs/development-testing-114","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"Error shapes, Host / Origin / token, raw uploads, Range, peaks, browse roots, submitting conversion through the API, events listed in OpenAPI","locale":"en"},"9906":{"id":"/en/docs/development-testing-115","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"`cli/`","locale":"en"},"9907":{"id":"/en/docs/development-testing-116","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"Command tree snapshot, `--debug` at each level, `config`, `--json` parity with the API, conversion by `.pth` path, missing-asset exit codes","locale":"en"},"9908":{"id":"/en/docs/development-testing-117","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"`workers/`","locale":"en"},"9909":{"id":"/en/docs/development-testing-118","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-layout","content":"Device worker (enumeration, format checks, test tones, and real local PortAudio enumeration); Live worker (start, hot updates, voice switches, reconnect after device loss, nonfatal errors, meters / passthrough / test tones, end-to-end process, idle release and OOM unloading); separation worker (chain events with a fake separator, no overwriting existing files, individual input failure, missing weights, fp32 retry requested after DirectML fp16 failure, cancellation by process kill); training worker (slice → F0 → features → index)","locale":"en"},"9910":{"id":"/en/docs/development-testing-119","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-doubles","content":"**Fake PortAudio** (`engine/audio_io/fake.py`): each device has its own clock (nominal rate multiplied by `1 + ppm·1e-6`); streams call back in blocks on threads; input comes from signal functions and output is recorded per device; `lose(index)` stops a device sending data (like unplugging USB), and `refuse` makes opening fail with a reason. Drift correction, underrun / overrun counts, device loss, and reconnection are tested on it. Live and device worker requests use it with `\"backend\": \"fake\"`.","locale":"en"},"9911":{"id":"/en/docs/development-testing-120","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-doubles","content":"**Fake separator**: when separation worker requests contain `test_fake`, `engine/separate/runner.py` uses `FakeSeparator` instead of pymss; it can pretend to be DirectML (`pretend_dml`) to test fp16 → fp32 retries.","locale":"en"},"9912":{"id":"/en/docs/development-testing-121","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#test-doubles","content":"**Recorded device enumerations** (`tests/fixtures/devices/`): `query_devices` / `query_hostapis` output from Windows (MME, DirectSound, WASAPI, WDM-KS, virtual sound cards), macOS, and Linux PipeWire machines, used to test grouping, sorting, virtual device flags, and every resolution outcome.","locale":"en"},"9913":{"id":"/en/docs/development-testing-122","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`rvc_next/webui` uses vitest (`happy-dom`) and `@vue/test-utils`, run with `bun run test`; `bun run typecheck` runs `vue-tsc`. `src/test/setup.ts` supplies the `attachInternals` missing from happy-dom (required by `@material/web`); `src/test/motion-zero.css` sets every motion duration to 0 for fast, deterministic motion tests.","locale":"en"},"9914":{"id":"/en/docs/development-testing-123","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Alongside component and store unit tests, **rule tests** turn conventions into failing tests: `tokens.test.ts` (no hexadecimal colors outside `src/theme/`), `imports.test.ts` (modules import through `@/` aliases), `layout.test.ts` (text in filename rows gets `min-width: 0`, pages use one column of sections, and other layout rules), `i18n/i18n.test.ts` (matching `zh-CN` and `en` keys and placeholders, fixed terminology), `ui/motion/motion.test.ts` (works with full and reduced motion, view transitions), etc. See Web UI for individual descriptions.","locale":"en"},"9915":{"id":"/en/docs/development-testing-124","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`.github/workflows/ci.yml` runs on pushes to `main`, pull requests, manual dispatch, and calls from other workflows (`release.yml` reuses it); new runs on the same branch cancel old ones:","locale":"en"},"9916":{"id":"/en/docs/development-testing-125","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Job","locale":"en"},"9917":{"id":"/en/docs/development-testing-126","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Environment","locale":"en"},"9918":{"id":"/en/docs/development-testing-127","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Contents","locale":"en"},"9919":{"id":"/en/docs/development-testing-128","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Lint and format","locale":"en"},"9920":{"id":"/en/docs/development-testing-129","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, Python 3.11","locale":"en"},"9921":{"id":"/en/docs/development-testing-130","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Install only the latest `ruff`; `ruff check` and `ruff format --check`. Also runs on pull requests","locale":"en"},"9922":{"id":"/en/docs/development-testing-131","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"ty","locale":"en"},"9923":{"id":"/en/docs/development-testing-132","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu / Windows / macOS × Python 3.10–3.13","locale":"en"},"9924":{"id":"/en/docs/development-testing-133","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"CPU torch plus `pip install -e . --group dev`, `ty check --python-version <version> --python-platform <platform> --error-on-warning`. Only resolves imports, so CPU torch suffices","locale":"en"},"9925":{"id":"/en/docs/development-testing-134","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Tests","locale":"en"},"9926":{"id":"/en/docs/development-testing-135","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, Python 3.10 and 3.12","locale":"en"},"9927":{"id":"/en/docs/development-testing-136","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Install `libportaudio2`, CPU torch, and development dependencies; `pytest -q`","locale":"en"},"9928":{"id":"/en/docs/development-testing-137","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Web UI","locale":"en"},"9929":{"id":"/en/docs/development-testing-138","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, latest bun","locale":"en"},"9930":{"id":"/en/docs/development-testing-139","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"`bun install --frozen-lockfile`, `bun run test`, `typecheck`, `build`, then `python scripts/dev.py typegen-check`","locale":"en"},"9931":{"id":"/en/docs/development-testing-140","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Documentation site","locale":"en"},"9932":{"id":"/en/docs/development-testing-141","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"Ubuntu, latest bun","locale":"en"},"9933":{"id":"/en/docs/development-testing-142","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"In `site/`, `bun install --frozen-lockfile`, `bun run check`, `test`, `build`","locale":"en"},"9934":{"id":"/en/docs/development-testing-143","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#ci","content":"CI does not install torchaudio or torchfcpe, so comparisons against them skip; golden tests are already deselected by default. See Development environment for release and documentation workflows.","locale":"en"},"9935":{"id":"/en/docs/development-webui","page_id":"/en/docs/development-webui","type":"page","content":"Web UI","breadcrumbs":["RVC Next Documentation","Development"],"tags":[],"url":"/en/docs/development-webui","locale":"en"},"9936":{"id":"/en/docs/development-webui-0","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui","content":"The Web UI is a Vue 3 project under rvcnext/webui/ and also a Python package: its git-ignored dist/ build is bundled as package data in the wheel and served by the API's SPAStaticFiles` (see API and events).","locale":"en"},"9937":{"id":"/en/docs/development-webui-1","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#technology-stack","content":"Technology stack","locale":"en"},"9938":{"id":"/en/docs/development-webui-2","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#development-proxy","content":"Development proxy","locale":"en"},"9939":{"id":"/en/docs/development-webui-3","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#directory-structure","content":"Directory structure","locale":"en"},"9940":{"id":"/en/docs/development-webui-4","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#ui-the-design-system-layer","content":"`ui/`: the design system layer","locale":"en"},"9941":{"id":"/en/docs/development-webui-5","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#theme-and-tokens","content":"Theme and tokens","locale":"en"},"9942":{"id":"/en/docs/development-webui-6","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#motion","content":"Motion","locale":"en"},"9943":{"id":"/en/docs/development-webui-7","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#unified-experience-contract","content":"Unified experience contract","locale":"en"},"9944":{"id":"/en/docs/development-webui-8","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#data-flow","content":"Data flow","locale":"en"},"9945":{"id":"/en/docs/development-webui-9","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#shell-view-state-and-layout","content":"Shell, view state, and layout","locale":"en"},"9946":{"id":"/en/docs/development-webui-10","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#internationalization","content":"Internationalization","locale":"en"},"9947":{"id":"/en/docs/development-webui-11","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#tests","content":"Tests","locale":"en"},"9948":{"id":"/en/docs/development-webui-12","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#adding-a-screen","content":"Adding a screen","locale":"en"},"9949":{"id":"/en/docs/development-webui-13","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui","content":"The Web UI is a Vue 3 project under `rvc_next/webui/` and also a Python package: its git-ignored `dist/` build is bundled as package data in the wheel and served by the API's `SPAStaticFiles` (see API and events). It has no business logic of its own—REST is the sole data source, and socket events only keep the cache fresh.","locale":"en"},"9950":{"id":"/en/docs/development-webui-14","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui","content":"The skeleton (theme, `ui/` components, motion, rule tests, API client, and socket wrapper) comes from Hanaikada, which inherited it from SD Model Hub; RVC Next adds audio components (waveforms, level meters, device menus, parameter sliders) and five feature screens. This page covers the stack, directories, shared components and unified experience contract, data flow, layout and motion rules, internationalization, tests, and steps for adding a screen.","locale":"en"},"9951":{"id":"/en/docs/development-webui-15","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Part","locale":"en"},"9952":{"id":"/en/docs/development-webui-16","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Choice","locale":"en"},"9953":{"id":"/en/docs/development-webui-17","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Notes","locale":"en"},"9954":{"id":"/en/docs/development-webui-18","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Framework","locale":"en"},"9955":{"id":"/en/docs/development-webui-19","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Vue 3.5, `<script setup lang=\"ts\">`","locale":"en"},"9956":{"id":"/en/docs/development-webui-20","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Build","locale":"en"},"9957":{"id":"/en/docs/development-webui-21","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Vite 8, `base: './'`","locale":"en"},"9958":{"id":"/en/docs/development-webui-22","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Relative asset paths: the same build works at the root or under a reverse proxy subpath","locale":"en"},"9959":{"id":"/en/docs/development-webui-23","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Language","locale":"en"},"9960":{"id":"/en/docs/development-webui-24","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"TypeScript 6 (pinned to 6)","locale":"en"},"9961":{"id":"/en/docs/development-webui-25","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"`vue-tsc` and `openapi-typescript` depend on compiler APIs removed in TypeScript 7","locale":"en"},"9962":{"id":"/en/docs/development-webui-26","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Routing","locale":"en"},"9963":{"id":"/en/docs/development-webui-27","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Vue Router 5, **hash history**","locale":"en"},"9964":{"id":"/en/docs/development-webui-28","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Works under any subpath without server rewrite rules","locale":"en"},"9965":{"id":"/en/docs/development-webui-29","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"State","locale":"en"},"9966":{"id":"/en/docs/development-webui-30","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#technology-stack","content":"Pinia 4 (high-frequency data, session state), TanStack