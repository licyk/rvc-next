:"/en/docs/development-assets#current-assets","content":"`fcpe/fcpe_c_v001.pt`","locale":"en"},"8375":{"id":"/en/docs/development-assets-49","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"FCPE pitch; only in rvc-model","locale":"en"},"8376":{"id":"/en/docs/development-assets-50","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`crepe`, `crepe-tiny`","locale":"en"},"8377":{"id":"/en/docs/development-assets-51","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"inference","locale":"en"},"8378":{"id":"/en/docs/development-assets-52","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`crepe/full.pth`, `crepe/tiny.pth`","locale":"en"},"8379":{"id":"/en/docs/development-assets-53","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"CREPE pitch (torchcrepe 0.0.24's weights); only in rvc-model","locale":"en"},"8380":{"id":"/en/docs/development-assets-54","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`pretrained-{v1,v2}-{32k,40k,48k}`","locale":"en"},"8381":{"id":"/en/docs/development-assets-55","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"training","locale":"en"},"8382":{"id":"/en/docs/development-assets-56","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`pretrained[_v2]/[f0]{G,D}<rate>.pth`","locale":"en"},"8383":{"id":"/en/docs/development-assets-57","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"Training base models, 4 files per asset (G/D pairs with and without pitch)","locale":"en"},"8384":{"id":"/en/docs/development-assets-58","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`separation-<model>`","locale":"en"},"8385":{"id":"/en/docs/development-assets-59","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"separation","locale":"en"},"8386":{"id":"/en/docs/development-assets-60","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`pymss_weights/<checkpoint>.ckpt`","locale":"en"},"8387":{"id":"/en/docs/development-assets-61","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"Five separation models: `dereverb`, `dereverb-aggressive`, `vocals`, `vocals-aggressive`, `karaoke`; YAML is bundled (`engine/separate/configs/`)","locale":"en"},"8388":{"id":"/en/docs/development-assets-62","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"There are 17 assets and 37 files, totaling about 4.9 GiB. SwiftF0's 165 KB weights are not an asset: they ship inside the package (`engine/f0/data/swift_f0.pt`). Base models are split by version × sample rate instead of the planned two assets `pretrained-v1`/`pretrained-v2`: training at one rate requires downloading 4 files rather than 12 (AGENTS.md §8). Separation weights live in `pymss_weights/` instead of the planned `separation/`, also to match the original layout.","locale":"en"},"8389":{"id":"/en/docs/development-assets-63","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`ids_for_group()` determines what `rvc-next assets download --group` includes: assets matching the catalog's `group`, or all assets for `all`, excluding the DirectML-only `rmvpe-onnx` (downloaded on demand). Thus `inference` (the default without arguments) includes `hubert`, `rmvpe`, `fcpe`, `crepe` and `crepe-tiny`.","locale":"en"},"8390":{"id":"/en/docs/development-assets-64","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#current-assets","content":"`paths.assets_dir` can point directly to the `assets/` folder of an existing original RVC installation. HuBERT, RMVPE, base models, and `pymss_weights` use the same relative paths, so nothing needs to be downloaded again.","locale":"en"},"8391":{"id":"/en/docs/development-assets-65","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"Repository ID","locale":"en"},"8392":{"id":"/en/docs/development-assets-66","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"Hugging Face repository","locale":"en"},"8393":{"id":"/en/docs/development-assets-67","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"ModelScope copy","locale":"en"},"8394":{"id":"/en/docs/development-assets-68","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"Contents","locale":"en"},"8395":{"id":"/en/docs/development-assets-69","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"`rvc-model` (default)","locale":"en"},"8396":{"id":"/en/docs/development-assets-70","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"licyk/rvc-model","locale":"en"},"8397":{"id":"/en/docs/development-assets-71","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"licyks/rvc-model (branch `master`)","locale":"en"},"8398":{"id":"/en/docs/development-assets-72","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"Every file RVC Next uses, organized by category, plus demo voices and `manifest.json`","locale":"en"},"8399":{"id":"/en/docs/development-assets-73","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"`official`","locale":"en"},"8400":{"id":"/en/docs/development-assets-74","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"lj1995/VoiceConversionWebUI","locale":"en"},"8401":{"id":"/en/docs/development-assets-75","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"None","locale":"en"},"8402":{"id":"/en/docs/development-assets-76","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"The official RVC repository; no demo voices, FCPE or CREPE weights","locale":"en"},"8403":{"id":"/en/docs/development-assets-77","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"Two settings determine download URLs (`AssetService.urls()`; `url()` is the first of them):","locale":"en"},"8404":{"id":"/en/docs/development-assets-78","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"`downloads.repository` (`rvc-model` or `official`) selects the **repository**. If a file is absent from the selected repository (no matching key in `sources`), use another listed repository automatically—demo voices, FCPE and CREPE therefore always download from rvc-model, even when the official repository is selected.","locale":"en"},"8405":{"id":"/en/docs/development-assets-79","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"`downloads.source` selects the **source**: `huggingface` (`https://huggingface.co`), `hf-mirror` (`https://hf-mirror.com`), `modelscope` (`https://www.modelscope.cn`), or `custom` (`downloads.endpoint`). The rvc-model entry in `catalog.json` carries `modelscope` (`licyks/rvc-model`) and `modelscope_revision` (`master`), which `GET /assets/repositories` returns in `Repository` too. Only rvc-model has a ModelScope copy: with ModelScope chosen, files come from that copy whichever repository is selected; files only on Hugging Face (the community base models' and Applio's content-feature models' upstream repositories) still come from huggingface.co.","locale":"en"},"8406":{"id":"/en/docs/development-assets-80","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"On Hugging Face the URL is `<endpoint>/<repo>/resolve/<revision>/<sources[repository]>`, both repositories currently at `main`; on ModelScope it is `https://www.modelscope.cn/models/<modelscope>/resolve/<modelscope_revision>/<sources[repository]>`.","locale":"en"},"8407":{"id":"/en/docs/development-assets-81","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"`urls()` lists every URL in the order tried: the chosen source first, then the other public ones (whichever of `huggingface`, `hf-mirror`, `modelscope` is not chosen); at each source the chosen repository first, then the others that host the file. A URL that answers 404/401/403/410, states another size (from `Content-Length` or `Content-Range`, before downloading), gives a wrong checksum, or stays unreachable after 4 retries gives way to the next, and the job log says “…; trying the next source”. When every URL fails, the job ends with `RvcNextError`, the last reasons in `detail.errors`.","locale":"en"},"8408":{"id":"/en/docs/development-assets-82","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"**ModelScope line endings**: ModelScope converts small text files committed inline to LF line endings (and always commits `config.json` inline), so HuBERT's `hubert_base/config.json` (1420 bytes) and `preprocessor_config.json` (216 bytes) are stored there with LF, unlike the official CRLF originals. A catalog file's `alternates` (a list of `{size, sha256}`) lists such other accepted contents: status, download and verification accept the original or any alternate.","locale":"en"},"8409":{"id":"/en/docs/development-assets-83","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"Hugging Face links in imports still go through a Hugging Face endpoint (`assets.service.hf_endpoint`): huggingface.co when the source is ModelScope.","locale":"en"},"8410":{"id":"/en/docs/development-assets-84","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"**Content-feature models** (group `embedder`, assets `embedder-<name>` in `embedders/<name>/`) are the HuBERT-style models Applio voices may be trained on (`engine/features/embedders.py`), from `hf:IAHispano/Applio` (upstream, pinned); the config files' hashes were computed from that revision, the weights' come from LFS. `assets download --group all` leaves them out.","locale":"en"},"8411":{"id":"/en/docs/development-assets-85","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"**Community base models** (group `community`, 21 assets `community-<name>-<rate>`) come from their authors' own repositories: each such repository is in `repositories` with `\"upstream\": true` and a pinned revision (a commit), its files have only that source, and `repositories()` leaves upstream ones out of the Settings choice. The list is the one Applio keeps (`IAHispano/Applio/pretrains.json`), every G checked to be a v2 pitch generator of the stated rate and every file's SHA-256 taken from the Hub's LFS metadata at that revision; DMR, whose repository is no longer public, is left out. An asset's `base_model` gives the name, rate, version, pitch guidance, the licence the repository states (often none) and its page; `BaseModelService` lists them as `source: \"community\"`. They are full training checkpoints (G about 440 MB, D 860 MB, with optimizer state), so `assets download --group all` leaves them out. Checkpoints saved with PyTorch's newer weight-norm names (`parametrizations.weight.original0/1`, as Ov2Super's 32k) are renamed to RVC's `weight_g`/`weight_v` on reading (`checkpoint.legacy_weight_norm`).","locale":"en"},"8412":{"id":"/en/docs/development-assets-86","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#two-download-repositories","content":"Why rvc-model exists: the official repository retains an early flat layout, mixing code, Windows executables, and tens of GB of distributions; some models (demo voices) exist only inside `.7z` distributions and cannot be downloaded individually (see below). rvc-model copies the required files unchanged into categories, making each file available separately.","locale":"en"},"8413":{"id":"/en/docs/development-assets-87","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Directory","locale":"en"},"8414":{"id":"/en/docs/development-assets-88","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Contents","locale":"en"},"8415":{"id":"/en/docs/development-assets-89","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Source","locale":"en"},"8416":{"id":"/en/docs/development-assets-90","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`hubert/hubert_base/`","locale":"en"},"8417":{"id":"/en/docs/development-assets-91","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"HuBERT (transformers format)","locale":"en"},"8418":{"id":"/en/docs/development-assets-92","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Official repository `hubert_base/`","locale":"en"},"8419":{"id":"/en/docs/development-assets-93","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`rmvpe/`","locale":"en"},"8420":{"id":"/en/docs/development-assets-94","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`rmvpe.pt`, `rmvpe.onnx`","locale":"en"},"8421":{"id":"/en/docs/development-assets-95","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Official repository root","locale":"en"},"8422":{"id":"/en/docs/development-assets-96","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`fcpe/`","locale":"en"},"8423":{"id":"/en/docs/development-assets-97","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`fcpe_c_v001.pt`","locale":"en"},"8424":{"id":"/en/docs/development-assets-98","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Weights bundled with torchfcpe 0.0.4 (the model RVC uses through `spawn_bundled_infer_model`)","locale":"en"},"8425":{"id":"/en/docs/development-assets-99","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`crepe/`","locale":"en"},"8426":{"id":"/en/docs/development-assets-100","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`full.pth`, `tiny.pth`, `LICENSE-CREPE.txt`","locale":"en"},"8427":{"id":"/en/docs/development-assets-101","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Weights bundled with torchcrepe 0.0.24 (MIT)","locale":"en"},"8428":{"id":"/en/docs/development-assets-102","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`pretrained/v1/`, `pretrained/v2/`","locale":"en"},"8429":{"id":"/en/docs/development-assets-103","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`[f0]G`, `[f0]D` for each sample rate","locale":"en"},"8430":{"id":"/en/docs/development-assets-104","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Official repository `pretrained/`, `pretrained_v2/`","locale":"en"},"8431":{"id":"/en/docs/development-assets-105","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`separation/`","locale":"en"},"8432":{"id":"/en/docs/development-assets-106","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Five separation checkpoints","locale":"en"},"8433":{"id":"/en/docs/development-assets-107","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Official repository `pymss_weights/`","locale":"en"},"8434":{"id":"/en/docs/development-assets-108","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"`voices/<name>/`","locale":"en"},"8435":{"id":"/en/docs/development-assets-109","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Demo voice `.pth` and `.index`","locale":"en"},"8436":{"id":"/en/docs/development-assets-110","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"Extracted from official `RVC*.7z` distributions","locale":"en"},"8437":{"id":"/en/docs/development-assets-111","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"The repository root also contains the official license files and `manifest.json`. `manifest.json` records each file's size, SHA-256, and upstream path (which official repository path, distribution archive, or torchfcpe it came from), serving as rvc-model's own inventory. Convention: update `manifest.json` when uploading files to rvc-model; sizes, hashes, and `rvc-model` paths in `catalog.json` are generated from the manifest. No script for this step is committed in this repository; changes to `catalog.json` must remain consistent with the manifest.","locale":"en"},"8438":{"id":"/en/docs/development-assets-112","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"All files copied from the official repository are unchanged; catalog hashes were recalculated against a full download of the official repository (revision `e6d0c1a`) and all matched.","locale":"en"},"8439":{"id":"/en/docs/development-assets-113","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#rvc-model-layout","content":"FCPE previously used the torchfcpe package, which depends on torchaudio and bundles a 43 MB model. Its inference path is now ported to `engine/f0/fcpe_model.py` (see Parity with the original), with weights downloaded as the `fcpe` asset, so RVC Next no longer depends on torchfcpe or torchaudio.","locale":"en"},"8440":{"id":"/en/docs/development-assets-114","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#downloads-resume-and-verification","content":"Downloads are `download` jobs (`io` resource, concurrency capacity 4), submitted by `AssetService.download(ids, group, verify_only, foreground)`; the CLI runs them in the foreground with `foreground=True`. Each asset is one job step.","locale":"en"},"8441":{"id":"/en/docs/development-assets-115","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#downloads-resume-and-verification","content":"**Skip existing files**: files whose sizes match the catalog are not downloaded again.","locale":"en"},"8442":{"id":"/en/docs/development-assets-116","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#downloads-resume-and-verification","content":"**Resume** (`_fetch()` tries each of `urls()`, `_fetch_from()` downloads one): write downloads to `<filename>.part`; when partial data exists, send `Range: bytes=<downloaded bytes>-`. A 200 response instead of 206 restarts writing; a `.part` already at an accepted size counts as finished; an oversized `.part` is deleted and downloaded again. Retry each URL at most 4 times (`RETRIES`), with 1, 2, 4… seconds of backoff (capped at 10 seconds). Wrong content (size or checksum) deletes the `.part` and moves to the next URL. On completion, rename `.part` to the final file.","locale":"en"},"8443":{"id":"/en/docs/development-assets-117","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#downloads-resume-and-verification","content":"**Verification**: compute SHA-256 and compare with the catalog (the original or one of its `alternates`) when `downloads.verify_checksums` (default on) or `verify_only` is enabled; a download is checked before the rename, so a URL serving damaged content is skipped.","locale":"en"},"8444":{"id":"/en/docs/development-assets-118","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#downloads-resume-and-verification","content":"**Verification cache**: store results in the data directory's `assets-verified.json`, keyed by `<path>|<size>|<mtime_ns>`. Size or modification-time changes naturally invalidate the cache. Listing asset status avoids repeatedly hashing several GB, while replaced files appear unverified again.","locale":"en"},"8445":{"id":"/en/docs/development-assets-119","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#downloads-resume-and-verification","content":"**Progress**: measured in bytes; `ctx.transfer(done, total)` lets job cards display speed and remaining time (see Core services).","locale":"en"},"8446":{"id":"/en/docs/development-assets-120","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#downloads-resume-and-verification","content":"Failed assets are marked `failed`; the job ends with `RvcNextError`, with failed IDs listed in `detail.assets`.","locale":"en"},"8447":{"id":"/en/docs/development-assets-121","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`AssetService.status(id)` reads only disk and the verification cache, without network requests:","locale":"en"},"8448":{"id":"/en/docs/development-assets-122","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"Status","locale":"en"},"8449":{"id":"/en/docs/development-assets-123","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"Condition","locale":"en"},"8450":{"id":"/en/docs/development-assets-124","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`downloading`","locale":"en"},"8451":{"id":"/en/docs/development-assets-125","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"A download job is processing it","locale":"en"},"8452":{"id":"/en/docs/development-assets-126","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`installed`","locale":"en"},"8453":{"id":"/en/docs/development-assets-127","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"Every file exists with the correct size, with no recorded verification failures","locale":"en"},"8454":{"id":"/en/docs/development-assets-128","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`corrupt`","locale":"en"},"8455":{"id":"/en/docs/development-assets-129","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"All files exist, but one failed verification","locale":"en"},"8456":{"id":"/en/docs/development-assets-130","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`partial`","locale":"en"},"8457":{"id":"/en/docs/development-assets-131","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"Some files (or partial bytes) exist","locale":"en"},"8458":{"id":"/en/docs/development-assets-132","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`missing`","locale":"en"},"8459":{"id":"/en/docs/development-assets-133","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"No bytes exist","locale":"en"},"8460":{"id":"/en/docs/development-assets-134","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`verified` is `True` (all verified), `False` (a failure), or `None` (some files not yet verified). `is_installed()` also counts `corrupt` as installed—the user may have replaced files with another version, so the UI warns rather than blocks use.","locale":"en"},"8461":{"id":"/en/docs/development-assets-135","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#status","content":"`delete(id)` removes all asset files and `.part` files (refused while downloading, 409) and clears the verification cache; deleting an official base model only calls `delete_files()` for its own G/D pair, making the asset `partial`. Status changes publish `assets_changed` (with all asset statuses as payload).","locale":"en"},"8462":{"id":"/en/docs/development-assets-136","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"`voice_catalog()` (`GET /models/catalog`, `rvc-next model catalog`) lists demo voices, marking those already downloaded into the library (`installed_voice_id`, matched through `catalog_id` in `voice.json`; DB migration 2 adds `voice_models.catalog_id` for this). `download_voices(ids, all_missing)` (`POST /models/catalog/download`, `rvc-next model download`) submits a `download` job with request `{\"voices\": [...]}`: download `.pth` and `.index` into a temporary directory under `uploads/`, check SHA-256 (always checked here, regardless of `verify_checksums`), then add them to the library with `catalog_id` as their source. Demo voices are ordinary library voices; deleting one makes it downloadable again in the catalog.","locale":"en"},"8463":{"id":"/en/docs/development-assets-137","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"id","locale":"en"},"8464":{"id":"/en/docs/development-assets-138","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"Version","locale":"en"},"8465":{"id":"/en/docs/development-assets-139","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"Sample rate","locale":"en"},"8466":{"id":"/en/docs/development-assets-140","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"Index","locale":"en"},"8467":{"id":"/en/docs/development-assets-141","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"`kikiv1`","locale":"en"},"8468":{"id":"/en/docs/development-assets-142","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"v1","locale":"en"},"8469":{"id":"/en/docs/development-assets-143","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"40k","locale":"en"},"8470":{"id":"/en/docs/development-assets-144","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"Yes","locale":"en"},"8471":{"id":"/en/docs/development-assets-145","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"`keruanv1`","locale":"en"},"8472":{"id":"/en/docs/development-assets-146","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"v1","locale":"en"},"8473":{"id":"/en/docs/development-assets-147","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"40k","locale":"en"},"8474":{"id":"/en/docs/development-assets-148","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"Yes","locale":"en"},"8475":{"id":"/en/docs/development-assets-149","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"`guanguanv1`","locale":"en"},"8476":{"id":"/en/docs/development-assets-150","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"v1","locale":"en"},"8477":{"id":"/en/docs/development-assets-151","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"40k","locale":"en"},"8478":{"id":"/en/docs/development-assets-152","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"Yes","locale":"en"},"8479":{"id":"/en/docs/development-assets-153","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"`zhanzhanv2-xi`","locale":"en"},"8480":{"id":"/en/docs/development-assets-154","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"v2","locale":"en"},"8481":{"id":"/en/docs/development-assets-155","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"40k","locale":"en"},"8482":{"id":"/en/docs/development-assets-156","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"Yes","locale":"en"},"8483":{"id":"/en/docs/development-assets-157","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"`youzhanv2-xi`","locale":"en"},"8484":{"id":"/en/docs/development-assets-158","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"v2","locale":"en"},"8485":{"id":"/en/docs/development-assets-159","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"48k","locale":"en"},"8486":{"id":"/en/docs/development-assets-160","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"No (no distribution contains its index; use index strength 0)","locale":"en"},"8487":{"id":"/en/docs/development-assets-161","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#demo-voices","content":"These voices have no named speakers and are treated as single-speaker voices despite their usual 109-row speaker embeddings. Like the official repository, they follow the MIT license and the authors' additional terms (research use only; users bear full responsibility for generated and distributed audio).","locale":"en"},"8488":{"id":"/en/docs/development-assets-162","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"The official repository contains two kinds of files: weights themselves and 21 Windows distributions (`RVC*.7z`, from 2023-03 to 2026-07, each a complete installation). A full inventory was taken of revision `e6d0c1a` (155 files, about 103 GB): index every `.7z`, compare model files over 50 KB (`.pth .pt .ckpt .onnx .bin .safetensors .index`, excluding bundled `runtime/` and legacy `TEMP/`) with repository files by size, then content; for files found only inside archives, extract by CRC-32, compute SHA-256, and actually load them. Findings:","locale":"en"},"8489":{"id":"/en/docs/development-assets-163","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Category","locale":"en"},"8490":{"id":"/en/docs/development-assets-164","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Files","locale":"en"},"8491":{"id":"/en/docs/development-assets-165","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Handling","locale":"en"},"8492":{"id":"/en/docs/development-assets-166","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Demo voices","locale":"en"},"8493":{"id":"/en/docs/development-assets-167","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"`kikiV1`, `keruanV1`, `guanguanV1` (with indexes), `youzhanv2-xi`, `zhanzhanv2-xi` (with index)","locale":"en"},"8494":{"id":"/en/docs/development-assets-168","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Uploaded unchanged to `voices/<name>/` in rvc-model and added to `voices` in `catalog.json`","locale":"en"},"8495":{"id":"/en/docs/development-assets-169","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Indexes without corresponding voices","locale":"en"},"8496":{"id":"/en/docs/development-assets-170","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"`anchun`, `keqing`, `mi-test`, `mi-test-v1`, `test`","locale":"en"},"8497":{"id":"/en/docs/development-assets-171","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Unused: their voices were never published","locale":"en"},"8498":{"id":"/en/docs/development-assets-172","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Superseded or duplicate weights","locale":"en"},"8499":{"id":"/en/docs/development-assets-173","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Old `rmvpe.pt` (weights before 2023-07); another archive copy of `model_bs_roformer_ep_317`","locale":"en"},"8500":{"id":"/en/docs/development-assets-174","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Unused: superseded by files in the repository itself","locale":"en"},"8501":{"id":"/en/docs/development-assets-175","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Non-model files","locale":"en"},"8502":{"id":"/en/docs/development-assets-176","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"`Synthesizer_inputs.pth`, `hubert_inputs.pth` (sample inputs for ONNX export), `logs/mute/*.spec.pt` (spectrogram caches generated by the training loader)","locale":"en"},"8503":{"id":"/en/docs/development-assets-177","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Unused","locale":"en"},"8504":{"id":"/en/docs/development-assets-178","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"All remaining model files in the archives are byte-identical to a file in the repository.","locale":"en"},"8505":{"id":"/en/docs/development-assets-179","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Why not download directly from distributions: these `.7z` files use solid compression; voices share 1.3–1.9 GB compressed blocks with other assets, so fetching one file requires downloading and decompressing at least its entire block. This is a major reason for rvc-model.","locale":"en"},"8506":{"id":"/en/docs/development-assets-180","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#models-found-only-in-official-distributions","content":"Other repository files excluded from the catalog, and why: `mute.zip` (identical silence samples are already bundled as package data; see `engine/train/data/mute/`); `hubert_base.pt` (fairseq checkpoint; RVC Next uses transformers format); `pretrained_v0/` (early v1 generators, never selected anywhere); `uvr5_weights/`, etc. (UVR5 separation; the ported branch had switched to PyMSS); `weights/白菜357k.pt` (a pre-RVC model format that cannot be loaded); `ffmpeg.exe`/`ffprobe.exe` (RVC Next decodes through PyAV); `RVCRealtime-Win64VST.zip` (live VST plugin, relevant to future VST adaptation); and early-version code.","locale":"en"},"8507":{"id":"/en/docs/development-assets-181","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#adding-or-updating-assets","content":"Upload files to the appropriate category in rvc-model and update its `manifest.json` (size, SHA-256, upstream path). If the official repository also has the file, record its path there.","locale":"en"},"8508":{"id":"/en/docs/development-assets-182","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#adding-or-updating-assets","content":"Add or update an entry in `assets` in `catalog.json`: `path` uses a relative path in the original `assets/` layout; `sources` lists at least one repository; `size` and `sha256` must match the manifest—downloads use size to determine completion and hashes to detect corruption.","locale":"en"},"8509":{"id":"/en/docs/development-assets-183","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#adding-or-updating-assets","content":"For vocal separation weights, also update `MODELS` in `engine/separate/presets.py` (checkpoint name, YAML name, size, SHA-256, primary and secondary stems), preset `assets` in `core/separation/presets.json`, and place the YAML in `engine/separate/configs/`. `tests/engine/test_separate_presets.py` checks preset consistency with `MODELS`, but does not check sizes and hashes in `MODELS` against `catalog.json`; compare those manually.","locale":"en"},"8510":{"id":"/en/docs/development-assets-184","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#adding-or-updating-assets","content":"If a feature requires the new asset, add its ID to the corresponding service's `require()` call (e.g. `ConversionService.required_assets()`, `LiveService._require_assets()`, `TrainingService._preflight()`); the UI automatically offers downloads through `AssetGate`.","locale":"en"},"8511":{"id":"/en/docs/development-assets-185","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#adding-or-updating-assets","content":"Add demo voices to `voices`; never change an `id` once published, since downloaded voices use it to match catalog entries.","locale":"en"},"8512":{"id":"/en/docs/development-assets-186","page_id":"/en/docs/development-assets","tags":[],"type":"text","url":"/en/docs/development-assets#adding-or-updating-assets","content":"Run `python scripts/dev.py check`. `tests/core/test_assets.py` uses mock transport to cover resume, verification, repository fallback, deletion, and demo voice import.","locale":"en"},"8513":{"id":"/en/docs/development-cli","page_id":"/en/docs/development-cli","type":"page","content":"CLI implementation","breadcrumbs":["RVC Next Documentation","Development"],"tags":[],"url":"/en/docs/development-cli","locale":"en"},"8514":{"id":"/en/docs/development-cli-0","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#structure","content":"Structure","locale":"en"},"8515":{"id":"/en/docs/development-cli-1","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#central-registration","content":"Central registration","locale":"en"},"8516":{"id":"/en/docs/development-cli-2","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#factory-and-custom-classes","content":"Factory and custom classes","locale":"en"},"8517":{"id":"/en/docs/development-cli-3","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#errors-and-exit-codes","content":"Errors and exit codes","locale":"en"},"8518":{"id":"/en/docs/development-cli-4","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#output---json-equals-api-json","content":"Output: `--json` equals API JSON","locale":"en"},"8519":{"id":"/en/docs/development-cli-5","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#services-and-foreground-jobs","content":"Services and foreground jobs","locale":"en"},"8520":{"id":"/en/docs/development-cli-6","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#voice-arguments","content":"Voice arguments","locale":"en"},"8521":{"id":"/en/docs/development-cli-7","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#the-webui-command","content":"The `webui` command","locale":"en"},"8522":{"id":"/en/docs/development-cli-8","page_id":"/en/docs/development-cli","type":"heading","tags":[],"url":"/en/docs/development-cli#adding-a-command","content":"Adding a command","locale":"en"},"8523":{"id":"/en/docs/development-cli-9","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli","content":"The `rvc-next` CLI is a thin shell over the core: each command parses arguments, calls one core method, and prints a table or JSON. This page explains its organization and the rules for adding commands. See Command reference for each command's options, and Configuration and environment variables for settings and environment variables.","locale":"en"},"8524":{"id":"/en/docs/development-cli-10","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"File","locale":"en"},"8525":{"id":"/en/docs/development-cli-11","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"Responsibility","locale":"en"},"8526":{"id":"/en/docs/development-cli-12","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`cli/app.py`","locale":"en"},"8527":{"id":"/en/docs/development-cli-13","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`get_app()` registers all commands and groups; `main()` runs the app and handles errors centrally","locale":"en"},"8528":{"id":"/en/docs/development-cli-14","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`cli/factory.py`","locale":"en"},"8529":{"id":"/en/docs/development-cli-15","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`typer_factory()` and custom Typer classes; imports of Typer's private `typer._click` module exist only here","locale":"en"},"8530":{"id":"/en/docs/development-cli-16","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`cli/commands/*.py`","locale":"en"},"8531":{"id":"/en/docs/development-cli-17","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"Command functions: plain functions without decorators","locale":"en"},"8532":{"id":"/en/docs/development-cli-18","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`cli/output.py`","locale":"en"},"8533":{"id":"/en/docs/development-cli-19","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`open_services()`, `print_json()`, `print_table()`, `human_size()`, etc.","locale":"en"},"8534":{"id":"/en/docs/development-cli-20","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`cli/params.py`","locale":"en"},"8535":{"id":"/en/docs/development-cli-21","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"Voice parameter options (`ParamOptions`) shared by `convert`, `live run`, and `preset save`, plus `build_params()`","locale":"en"},"8536":{"id":"/en/docs/development-cli-22","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"`cli/progress.py`","locale":"en"},"8537":{"id":"/en/docs/development-cli-23","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"Rich progress bars (`job_progress()`) and completion handling (`finish()`) for foreground jobs","locale":"en"},"8538":{"id":"/en/docs/development-cli-24","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"There are two entry points: `[project.scripts]` in `pyproject.toml` maps `rvc-next` to `rvc_next.cli.app:main`, and `rvc_next/__main__.py` makes `python -m rvc_next` call the same `main()` (this is how `dev.py dev` starts the API).","locale":"en"},"8539":{"id":"/en/docs/development-cli-25","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#structure","content":"This structure comes from ani2xcur-cli, carried forward through SD Model Hub.","locale":"en"},"8540":{"id":"/en/docs/development-cli-26","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#central-registration","content":"`get_app()` is the CLI's directory: every command is registered here with `app.command(help=..., name=...)(function)`, with its name and help supplied at registration rather than derived from its function name or docstring (`live_test_tone` is registered as `test-tone`, `model_list` as `list`). A command group is another app created by `typer_factory()`, attached with `add_typer(..., name=...)`, at most three levels deep (`model index assign`). Apps are built inside the function; importing the module creates nothing.","locale":"en"},"8541":{"id":"/en/docs/development-cli-27","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#central-registration","content":"The current command tree:","locale":"en"},"8542":{"id":"/en/docs/development-cli-28","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#central-registration","content":"`EXPECTED_TREE` in `tests/cli/test_cli.py` is a snapshot of this tree; `test_command_tree` compares each level. Adding or removing commands without updating it fails the test intentionally: the CLI is a public interface, and changes should be explicit decisions.","locale":"en"},"8543":{"id":"/en/docs/development-cli-29","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`typer_factory(help)` gives every app and command group the same settings:","locale":"en"},"8544":{"id":"/en/docs/development-cli-30","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"Setting","locale":"en"},"8545":{"id":"/en/docs/development-cli-31","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"Effect","locale":"en"},"8546":{"id":"/en/docs/development-cli-32","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`add_completion=True`","locale":"en"},"8547":{"id":"/en/docs/development-cli-33","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"Shell completion support","locale":"en"},"8548":{"id":"/en/docs/development-cli-34","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`no_args_is_help=True`","locale":"en"},"8549":{"id":"/en/docs/development-cli-35","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"Show help when the app or group is run without arguments","locale":"en"},"8550":{"id":"/en/docs/development-cli-36","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`cls=AlphabeticalMixedGroup`","locale":"en"},"8551":{"id":"/en/docs/development-cli-37","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"Groups have `--debug` and list commands and subgroups alphabetically","locale":"en"},"8552":{"id":"/en/docs/development-cli-38","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`rich_markup_mode=None`, `rich_help_panel=None`","locale":"en"},"8553":{"id":"/en/docs/development-cli-39","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"Plain-text help","locale":"en"},"8554":{"id":"/en/docs/development-cli-40","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`pretty_exceptions_enable=False`","locale":"en"},"8555":{"id":"/en/docs/development-cli-41","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"Leave exception handling to `main()`","locale":"en"},"8556":{"id":"/en/docs/development-cli-42","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`--debug` is available at every level (`rvc-next --debug version`, `rvc-next model --debug list`, `rvc-next model index --debug --help`), without any command function declaring a `debug` parameter. Three parts implement it:","locale":"en"},"8557":{"id":"/en/docs/development-cli-43","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`_make_debug_option()` creates a flag with `is_eager=True`, `expose_value=False`; its callback sets the `rvc_next` logger to `DEBUG`. Eager evaluation makes it apply before the command body; hiding the value keeps it out of command arguments; the callback does nothing when `ctx.resilient_parsing` is true (shell completion).","locale":"en"},"8558":{"id":"/en/docs/development-cli-44","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`DebugTyperCommand` and `AlphabeticalMixedGroup` insert this option at the start of the parameter list in `__init__` (without duplicating it if already present).","locale":"en"},"8559":{"id":"/en/docs/development-cli-45","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`DebugOptionTyper.command()` defaults to `DebugTyperCommand`; the factory's `cls=` specifies the group class.","locale":"en"},"8560":{"id":"/en/docs/development-cli-46","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#factory-and-custom-classes","content":"`test_debug_everywhere` covers all three positions.","locale":"en"},"8561":{"id":"/en/docs/development-cli-47","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#errors-and-exit-codes","content":"Domain errors (`core/errors.py`) each carry an `exit_code`; see Architecture for the full mapping. The CLI converts them to exit codes in two places:","locale":"en"},"8562":{"id":"/en/docs/development-cli-48","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#errors-and-exit-codes","content":"**`DebugTyperCommand.invoke()`** catches `RvcNextError`, logs `e.message`, adds `Install with: rvc-next assets download <ids>` when `detail.assets` is nonempty, then calls `raise typer.Exit(e.exit_code)`. This belongs in the command class as well as `main()` because tests use `typer.testing.CliRunner` to invoke Click commands directly, bypassing `main()`. Tests therefore see the same exit codes as users (`test_missing_asset_exit_code` asserts 7 for missing assets, and 2 for `model info nope`).","locale":"en"},"8563":{"id":"/en/docs/development-cli-49","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#errors-and-exit-codes","content":"**`main()`** is the fallback: preserve `typer.Exit`, use 1 for `Abort`, display `ClickException` and use its exit code (2 for argument errors), use the code from `RvcNextError`, 130 for `KeyboardInterrupt`, and print a traceback then exit 1 for other exceptions.","locale":"en"},"8564":{"id":"/en/docs/development-cli-50","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#errors-and-exit-codes","content":"Foreground job failures are recorded in `Job.error` rather than raised as exceptions. `finish(job)` in `cli/progress.py` handles completion: return for `completed`; exit 130 for `cancelled`; on failure, print the message and find the error class's exit code by `job.error.code` (3 for `busy`, 4 for `invalid_model`). Thus `rvc-next convert` exits 7 when RMVPE is missing, whether detected during pre-submission validation or job execution.","locale":"en"},"8565":{"id":"/en/docs/development-cli-51","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#errors-and-exit-codes","content":"A few commands choose exit codes themselves, consistently with domain errors: `webui` exits 4 when a certificate file is missing and 3 when no port is available; `model import` prints an ambiguous import plan and exits 3; `live check` / `live run` exit 8 for device problems. CLI-only argument validation uses `typer.BadParameter` (exit code 2).","locale":"en"},"8566":{"id":"/en/docs/development-cli-52","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#output---json-equals-api-json","content":"Every command that lists or displays data has `--json`. `print_json()` serializes `Record` with `model_dump(mode=\"json\")` (recursively handling lists and dictionaries, converting `Path` to strings), so output exactly matches API JSON. This is more than a convention: commands and routes call the same core method and return the same `Record`. `test_model_json_matches_api_shape` directly compares `rvc-next model list --json` with `GET /api/v1/models`.","locale":"en"},"8567":{"id":"/en/docs/development-cli-53","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#output---json-equals-api-json","content":"Without `--json`, `print_table()` renders a Rich table. Logs (including errors) go to **stderr** through `RichHandler` in `rvc_next/logger.py`, while data goes to **stdout**, so logs do not disrupt `rvc-next model list --json | jq`. The default log level is `INFO`, adjustable with `RVC_NEXT_LOG_LEVEL` or `--debug`.","locale":"en"},"8568":{"id":"/en/docs/development-cli-54","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#services-and-foreground-jobs","content":"Commands obtain services with `with open_services() as services:`. Its call to `build_services()` **starts no background threads**: no scheduler, idle unloading, or Live worker supervision. Services close when the command finishes.","locale":"en"},"8569":{"id":"/en/docs/development-cli-55","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#services-and-foreground-jobs","content":"Long operations (conversion, separation, training, downloads, merging, extraction, index building) are core jobs. The CLI calls core methods with `foreground=True`, routing them through `JobService.run_now()`: jobs still enter the database and publish events, but execute **on the calling thread**. Ctrl+C sets the cancellation flag, cancels the engine token, and kills worker subprocesses; the job ends as `cancelled`.","locale":"en"},"8570":{"id":"/en/docs/development-cli-56","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#services-and-foreground-jobs","content":"`job_progress(services)` subscribes to the same `job_updated` / `job_log` events as the Web UI, draws a transient Rich progress bar on stderr (\"title · current step\"), and prints log lines starting with `error` or `Traceback` in red. It shows no bar when stderr is not a terminal or `--json` is used.","locale":"en"},"8571":{"id":"/en/docs/development-cli-57","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#services-and-foreground-jobs","content":"Some command-specific behavior:","locale":"en"},"8572":{"id":"/en/docs/development-cli-58","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#services-and-foreground-jobs","content":"**`jobs list` / `jobs show`** read the shared database in the data directory, so they can see a running server's jobs; SQLite WAL and `busy_timeout` make these concurrent reads safe. `jobs show --log` reads job logs in chunks by byte offset. Jobs can only be cancelled through the Web UI or by pressing Ctrl+C in a foreground command.","locale":"en"},"8573":{"id":"/en/docs/development-cli-59","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#services-and-foreground-jobs","content":"**`live run`** starts the same Live worker in the foreground and refreshes a status line four times per second (state, load `infer_ms_p95 / block_ms`, latency, levels), until Ctrl+C, the `--seconds` limit, or an error. Device options `--input`, `--output`, `--monitor` accept a device ID, name, or `default`, resolved against a freshly enumerated device list first.","locale":"en"},"8574":{"id":"/en/docs/development-cli-60","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#services-and-foreground-jobs","content":"**`webui`** starts the server; see the steps below.","locale":"en"},"8575":{"id":"/en/docs/development-cli-61","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#voice-arguments","content":"A voice can be specified by ID, name, or `.pth` path. With a path, `convert` uses `services.models.temporary()` to register a **temporary voice** (`tmp-…`, hidden from lists), with an optional index supplied by `--index`; parameters start from `convert.default_params` rather than the voice's default preset. `live run` only accepts library voices (`resolve(..., allow_path=False)`): `LiveConfig` identifies the voice by ID, saved as `live.last_voice` after startup so the next `live run` without `--voice` and the Web UI can restore the session.","locale":"en"},"8576":{"id":"/en/docs/development-cli-62","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#voice-arguments","content":"`ParamOptions` in `cli/params.py` defines `--speaker`, `--pitch`, `--formant`, `--f0`, `--index-rate`, `--protect`, `--rms-mix`, `--unvoiced`, with the same ranges as `VoiceParamsModel`. `build_params(base, **overrides)` overlays only user-supplied options on `base` (the voice's default preset, the preset selected by `--preset`, or the last Live parameters), then validates with `VoiceParamsModel`. This matches the Web UI: selecting a voice loads its default preset, so it sounds the same in Convert and Live.","locale":"en"},"8577":{"id":"/en/docs/development-cli-63","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#the-webui-command","content":"`cli/commands/webui.py` is the only CLI file that imports the API layer (inside the function):","locale":"en"},"8578":{"id":"/en/docs/development-cli-64","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#the-webui-command","content":"`--data-dir` sets `RVC_NEXT_DATA_DIR` so subsequently started workers use the same data directory; then call `build_services(start_background=True)`.","locale":"en"},"8579":{"id":"/en/docs/development-cli-65","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#the-webui-command","content":"Warn when the host is not loopback (no access token is required).","locale":"en"},"8580":{"id":"/en/docs/development-cli-66","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#the-webui-command","content":"`bind_first_free_port(host, port, strict=...)` **binds the socket first**, trying higher ports when occupied (`--strict-port` fails immediately with exit code 3); warn if the actual port differs from the requested one. Binding rather than attempting a connection removes the gap between checking and actually binding, and detects Windows system-reserved ports.","locale":"en"},"8581":{"id":"/en/docs/development-cli-67","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#the-webui-command","content":"Build the app with `create_app(services, bound_host=..., bound_port=...)`, write `server.json`, print `SERVER_READY url=http://…` to stdout (for launchers and other programs), and open the browser after 0.8 seconds if requested.","locale":"en"},"8582":{"id":"/en/docs/development-cli-68","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#the-webui-command","content":"`uvicorn.Server(...).run(sockets=[sock])` serves on the socket just bound; on exit, delete `server.json` and close services.","locale":"en"},"8583":{"id":"/en/docs/development-cli-69","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#the-webui-command","content":"See API and events for details.","locale":"en"},"8584":{"id":"/en/docs/development-cli-70","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"**Start with a core method.** If the core lacks a method for the operation, add one to the appropriate service, taking and returning `Record` models. Keep business logic out of commands, or the API and Web UI would each need their own implementation.","locale":"en"},"8585":{"id":"/en/docs/development-cli-71","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"**Write a plain function in `cli/commands/`**, declaring parameters with `Annotated[..., typer.Option(...)]` / `typer.Argument(...)`, without decorators:","locale":"en"},"8586":{"id":"/en/docs/development-cli-72","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"**Required options have no default**, and precede parameters with defaults (as Python requires). Do not write `= ...`: Typer treats parameters without defaults as required; `...` is an older form whose type conflicts with the annotation, producing a ty error.","locale":"en"},"8587":{"id":"/en/docs/development-cli-73","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"Commands listing or displaying data provide `--json` and print the core method's `Record` directly.","locale":"en"},"8588":{"id":"/en/docs/development-cli-74","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"For long operations, pass `foreground=True` to the core method, wrap it in `with job_progress(services, enabled=not json_output):`, and call `finish(job)` afterward.","locale":"en"},"8589":{"id":"/en/docs/development-cli-75","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"Raise domain errors directly; `DebugTyperCommand` converts them to exit codes. Use `typer.BadParameter` for CLI-only argument problems.","locale":"en"},"8590":{"id":"/en/docs/development-cli-76","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"**Register it in `get_app()` in `cli/app.py`**, supplying `name` and `help`; create new command groups with `typer_factory(help=...)` and attach them with `add_typer`.","locale":"en"},"8591":{"id":"/en/docs/development-cli-77","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"**Update `EXPECTED_TREE` in `tests/cli/test_cli.py`**, and test the command (use the `runner` fixture, which sets the data directory, tiny asset directory, and CPU device through environment variables).","locale":"en"},"8592":{"id":"/en/docs/development-cli-78","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"Confirm that importing `rvc_next.cli.app` still loads neither torch nor FastAPI (`tests/test_architecture.py` checks this).","locale":"en"},"8593":{"id":"/en/docs/development-cli-79","page_id":"/en/docs/development-cli","tags":[],"type":"text","url":"/en/docs/development-cli#adding-a-command","content":"Add the command to the user documentation's Command reference.","locale":"en"},"8594":{"id":"/en/docs/development-core","page_id":"/en/docs/development-core","type":"page","content":"Core services","breadcrumbs":["RVC Next Documentation","Development"],"tags":[],"url":"/en/docs/development-core","locale":"en"},"8595":{"id":"/en/docs/development-core-0","page_id":"/en/docs/development-core","tags":[],"type":"text","url":"/en/docs/development-core","content":"Core (rvcnext/core/) contains all RVC Next business logic: job scheduling, GPU memory management, asset downloads, the voice library and imports, conversion, vocal separation, training, live voice conversion, and their shared settings, events and database. The API and CLI are thin wrappers; it calls the engine (rvcnext/engine/) through functions and imports torch lazily only inside functions.","locale":"en"},"8596":{"id":"/en/docs/development-core-1","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#service-overview","content":"Service overview","locale":"en"},"8597":{"id":"/en/docs/development-core-2","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#jobs","content":"Jobs","locale":"en"},"8598":{"id":"/en/docs/development-core-3","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#registration-and-requests","content":"Registration and requests","locale":"en"},"8599":{"id":"/en/docs/development-core-4","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#states-and-scheduling","content":"States and scheduling","locale":"en"},"8600":{"id":"/en/docs/development-core-5","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#two-runners","content":"Two runners","locale":"en"},"8601":{"id":"/en/docs/development-core-6","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#failures","content":"Failures","locale":"en"},"8602":{"id":"/en/docs/development-core-7","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#progress-logs-and-persistence","content":"Progress, logs and persistence","locale":"en"},"8603":{"id":"/en/docs/development-core-8","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#restarts-and-history","content":"Restarts and history","locale":"en"},"8604":{"id":"/en/docs/development-core-9","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#gpu-memory","content":"GPU memory","locale":"en"},"8605":{"id":"/en/docs/development-core-10","page_id":"/en/docs/development-core","type":"heading","tags":[],"url":"/en/docs/development-core#assets","content":"Assets","locale":"en"},"8606":{"id":"/en/docs/development-core-11","page_id":"/en/docs/development-core","type":"heading","tags":