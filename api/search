anual editing is unnecessary.","locale":"en"},"7691":{"id":"/en/docs/cli-config-341","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"Setting","locale":"en"},"7692":{"id":"/en/docs/cli-config-342","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"When it takes effect","locale":"en"},"7693":{"id":"/en/docs/cli-config-343","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"`server.host`, `server.port`, `server.strict_port`, `server.open_browser`, `server.ssl_certfile`, `server.ssl_keyfile`","locale":"en"},"7694":{"id":"/en/docs/cli-config-344","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"Next server start (marked **Takes effect the next time the server starts.** in the Web UI)","locale":"en"},"7695":{"id":"/en/docs/cli-config-345","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"`server.access_token`","locale":"en"},"7696":{"id":"/en/docs/cli-config-346","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"Immediately","locale":"en"},"7697":{"id":"/en/docs/cli-config-347","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"`server.allowed_origins`","locale":"en"},"7698":{"id":"/en/docs/cli-config-348","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"Origin checks take effect immediately; CORS response headers are configured at startup and require a restart","locale":"en"},"7699":{"id":"/en/docs/cli-config-349","page_id":"/en/docs/cli-config","tags":[],"type":"te