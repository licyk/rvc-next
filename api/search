docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#latency-estimation","content":"Latency estimation","locale":"en"},"9121":{"id":"/en/docs/development-engine-24","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#audio-codecs-and-dsp","content":"Audio codecs and DSP","locale":"en"},"9122":{"id":"/en/docs/development-engine-25","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#real-time-audio-devices-audio_io","content":"Real-time audio devices (`audio_io`)","locale":"en"},"9123":{"id":"/en/docs/development-engine-26","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#enumeration-and-grouping-devicespy","content":"Enumeration and grouping (`devices.py`)","locale":"en"},"9124":{"id":"/en/docs/development-engine-27","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#sessions-and-topology-streamspy","content":"Sessions and topology (`streams.py`)","locale":"en"},"9125":{"id":"/en/docs/development-engine-28","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#recording-an-output-device-capturepy","content":"Recording an output device (`capture.py`)","locale":"en"},"9126":{"id":"/en/docs/development-engine-29","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#live-worker-and-control-protocol","content":"Live worker and control protocol","locale":"en"},"9127":{"id":"/en/docs/development-engine-30","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#vocal-separation","content":"Vocal separation","locale":"en"},"9128":{"id":"/en/docs/development-engine-31","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#training","content":"Training","locale":"en"},"9129":{"id":"/en/docs/development-engine-32","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#fingerprints","content":"Fingerprints","locale":"en"},"9130":{"id":"/en/docs/development-engine-33","page_id":"/en/docs/development-engine","type":"heading","tags":[],"url":"/en/docs/development-engine#worker-subprocess-entry-points","content":"Worker subprocess entry points","locale":"en"},"9131":{"id":"/en/docs/development-engine-34","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine","content":"`rvc_next/engine/` contains all machine learning and digital signal processing code: device selection, model caches, HuBERT features, F0 extraction, retrieval indexes, synthesizer networks, offline conversion, streaming conversion, audio codecs, real-time audio devices, vocal separation and every training stage. It knows nothing about the application—it imports neither `rvc_next.core/api/cli/workers`, pydantic nor any Web/CLI framework (enforced by `tests/test_architecture.py`; see Architecture). Core, worker subprocesses and tests are simply its callers.","locale":"en"},"9132":{"id":"/en/docs/development-engine-35","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine","content":"This page explains what each engine module does and why. For rules on line-by-line comparison with the original, golden tests and behaviour changes, see Parity with the original.","locale":"en"},"9133":{"id":"/en/docs/development-engine-36","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#conventions","content":"**Parameters are frozen dataclasses**: `VoiceParams` (`engine/convert/params.py`), `StreamParams` (`engine/stream/params.py`), and the training stages' `SliceRequest`, `F0Request`, `FeatureRequest`, `TrainRequest`, `IndexRequest`. Core mirrors the first two with `VoiceParamsModel`/`StreamParamsModel` (`core/params.py`) and adds ranges; the engine itself does not validate ranges.","locale":"en"},"9134":{"id":"/en/docs/development-engine-37","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#conventions","content":"**Heavy dependencies are imported inside functions**: torch, transformers, faiss, av, pymss, sounddevice and parselmouth use `import` inside the functions needing them, so `import rvc_next.engine.xxx` is cheap and `rvc-next --help` does not load torch. Exceptions are ported files (`engine/graph.py`, `engine/f0/rmvpe.py`, `engine/f0/fcpe_model.py`, `engine/audio/sinc_resample.py`, `engine/audio/denoise.py`, `engine/models/*.py`): they import torch at module scope and must themselves be imported lazily from other functions.","locale":"en"},"9135":{"id":"/en/docs/development-engine-38","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#conventions","content":"**Exceptions** are limited to those in `engine/errors.py`: base `EngineError`, `MissingAssetError` (with `assets`, a list of asset catalog ids), `ModelFormatError`, `AudioError`, `Cancelled`. Core maps them to domain errors in `core/engine_errors.py:map_engine_error()`; worker subprocesses turn them into `error` events in `workers/base.py:run_worker()`, which core reconstructs with `worker_error()`.","locale":"en"},"9136":{"id":"/en/docs/development-engine-39","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#conventions","content":"**Cancellation** is cooperative: `engine/cancel.py:CancelToken`; the engine calls `cancel.check()` between chunks, raising `Cancelled`. Subprocess work does not rely on it: cancellation kills the process tree.","locale":"en"},"9137":{"id":"/en/docs/development-engine-40","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#conventions","content":"**`sounddevice` appears only under `engine/audio_io/`, `pymss` only under `engine/separate/`** (checked by architecture tests), so the rest of the engine can be imported without PortAudio or pymss.","locale":"en"},"9138":{"id":"/en/docs/development-engine-41","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"Module","locale":"en"},"9139":{"id":"/en/docs/development-engine-42","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"Purpose","locale":"en"},"9140":{"id":"/en/docs/development-engine-43","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"Source in the original","locale":"en"},"9141":{"id":"/en/docs/development-engine-44","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"`runtime.py`","locale":"en"},"9142":{"id":"/en/docs/development-engine-45","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"GPU rules, `ChunkConfig`, asset paths, model caches, GPU memory release and OOM detection","locale":"en"},"9143":{"id":"/en/docs/development-engine-46","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"GPU rules in `configs/config.py`","locale":"en"},"9144":{"id":"/en/docs/development-engine-47","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"`graph.py`","locale":"en"},"9145":{"id":"/en/docs/development-engine-48","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en/docs/development-engine#module-map","content":"CUDA Graph capture and replay cache","locale":"en"},"9146":{"id":"/en/docs/development-engine-49","page_id":"/en/docs/development-engine","tags":[],"type":"text","url":"/en