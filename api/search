2065":{"id":"/en/docs/installation-1","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#prerequisites","content":"Prerequisites","locale":"en"},"12066":{"id":"/en/docs/installation-2","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#step-1-create-a-virtual-environment","content":"Step 1: Create a virtual environment","locale":"en"},"12067":{"id":"/en/docs/installation-3","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#step-2-install-pytorch","content":"Step 2: Install PyTorch","locale":"en"},"12068":{"id":"/en/docs/installation-4","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#step-3-install-rvc-next","content":"Step 3: Install RVC Next","locale":"en"},"12069":{"id":"/en/docs/installation-5","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#install-from-source","content":"Install from source","locale":"en"},"12070":{"id":"/en/docs/installation-6","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#step-4-optional-portaudio-for-live-voice-conversion","content":"Step 4 (optional): PortAudio for live voice conversion","locale":"en"},"12071":{"id":"/en/docs/installation-7","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#step-5-verify-the-installation","content":"Step 5: Verify the installation","locale":"en"},"12072":{"id":"/en/docs/installation-8","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#next-step","content":"Next step","locale":"en"},"12073":{"id":"/en/docs/installation-9","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"Requirement","locale":"en"},"12074":{"id":"/en/docs/installation-10","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"Description","locale":"en"},"12075":{"id":"/en/docs/installation-11","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"Python","locale":"en"},"12076":{"id":"/en/docs/installation-12","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"3.10 or newer (3.10 through 3.14)","locale":"en"},"12077":{"id":"/en/docs/installation-13","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"Isolated virtual environment","locale":"en"},"12078":{"id":"/en/docs/installation-14","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"A venv or standalone Python dedicated to RVC Next; **do not** share it with other applications","locale":"en"},"12079":{"id":"/en/docs/installation-15","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"PyTorch","locale":"en"},"12080":{"id":"/en/docs/installation-16","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"Version 2.7.1 or newer; choose a CUDA or CPU build for your hardware and install it **before** RVC Next","locale":"en"},"12081":{"id":"/en/docs/installation-17","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"Disk space","locale":"en"},"12082":{"id":"/en/docs/installation-18","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"Models need additional space: HuBERT and RMVPE, required for conversion, take about 353 MB; each separation model takes 300–440 MB, and each set of training base models about 350–420 MB","locale":"en"},"12083":{"id":"/en/docs/installation-19","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"PortAudio (Linux only, live voice conversion only)","locale":"en"},"12084":{"id":"/en/docs/installation-20","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"See below","locale":"en"},"12085":{"id":"/en/docs/installation-21","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"RVC Next restricts dependencies to tested version ranges. For example, it requires `transformers` 5.x, whose `tokenizers` dependency requires `huggingface_hub` below 2. If another project in the same environment needs `huggingface_hub` 2.x, they cannot coexist. A dedicated virtual environment avoids these conflicts.","locale":"en"},"12086":{"id":"/en/docs/installation-22","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#prerequisites","content":"RVC Next has ported the resampling and FCPE code it needs. It no longer depends on `torchaudio`, and you do not need to install `torchfcpe` separately.","locale":"en"},"12087":{"id":"/en/docs/installation-23","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-1-create-a-virtual-environment","content":"`py -3.11` is only an example; replace it with any installed version from 3.10 through 3.14. Run all subsequent commands in a terminal with this environment activated.","locale":"en"},"12088":{"id":"/en/docs/installation-24","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"PyTorch needs a build suited to your hardware, so install it separately **first**. The version must be 2.7.1 or newer. Choose the command for your operating system and GPU below; pytorch.org lists the other builds.","locale":"en"},"12089":{"id":"/en/docs/installation-25","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"Windows and Linux:","locale":"en"},"12090":{"id":"/en/docs/installation-26","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"The CUDA 13.0 build needs a current NVIDIA driver (version 580 or newer).","locale":"en"},"12091":{"id":"/en/docs/installation-27","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"Windows and Linux:","locale":"en"},"12092":{"id":"/en/docs/installation-28","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"This is AMD's own ROCm 10 build, from AMD's package index (its PyTorch releases trail the official ones, hence 2.13). The `device-all` extra installs the GPU code for every AMD GPU it supports (one `amd-torch-device-gfx…` package per GPU family), so the download is large. AMD GPUs then appear as `cuda:N`. The quotes keep shells such as zsh from reading the square brackets as a file pattern.","locale":"en"},"12093":{"id":"/en/docs/installation-29","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"Windows and Linux:","locale":"en"},"12094":{"id":"/en/docs/installation-30","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"Needs a current Intel GPU driver. Intel GPUs then appear as `xpu:N`.","locale":"en"},"12095":{"id":"/en/docs/installation-31","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"PyTorch on macOS includes Apple MPS support (Apple silicon, macOS 14 or newer).","locale":"en"},"12096":{"id":"/en/docs/installation-32","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"Use this when no GPU is available. Conversion and separation both work on CPU, but run more slowly; training on CPU is very slow.","locale":"en"},"12097":{"id":"/en/docs/installation-33","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"DirectML is a fallback for AMD and Intel GPUs on Windows that the ROCm and XPU builds above do not support. Install PyTorch as shown under “CPU only”, then install RVC Next with the `directml` extra in step 3:","locale":"en"},"12098":{"id":"/en/docs/installation-34","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-2-install-pytorch","content":"This extra installs `torch-directml` and `onnxruntime-directml`. `torch-directml` has its own PyTorch version requirements, which can be older than the version above; install the PyTorch version it asks for, as long as it is 2.7.1 or newer. This path is experimental.","locale":"en"},"12099":{"id":"/en/docs/installation-35","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-3-install-rvc-next","content":"Since PyTorch is already installed, pip considers the `torch` dependency satisfied and will not replace it with another build. After installation, the `rvc-next` command is available in the environment.","locale":"en"},"12100":{"id":"/en/docs/installation-36","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-3-install-rvc-next","content":"The **effects** chain on Convert and Live (reverb, compressor, delay and more) needs pedalboard, an optional extra:","locale":"en"},"12101":{"id":"/en/docs/installation-37","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-3-install-rvc-next","content":"**Text to speech** as an input on Convert needs the `tts` extra (edge-tts, which uses Microsoft's online voices): `python -m pip install \"rvc-next[tts]\"`. Extras combine: `\"rvc-next[effects,tts]\"`.","locale":"en"},"12102":{"id":"/en/docs/installation-38","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-from-source","content":"To use the latest code or contribute to development, install from source:","locale":"en"},"12103":{"id":"/en/docs/installation-39","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-from-source","content":"The source **does not include a built web interface** (`rvc_next/webui/dist` is not in the repository). Without it, `rvc-next webui` serves only the API and logs `No web UI build found`. Building the web interface requires bun:","locale":"en"},"12104":{"id":"/en/docs/installation-40","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-from-source","content":"To build a wheel yourself, use `python scripts/build_wheel.py`, which builds the web interface before packaging; a package built directly with `python -m build` will not include the web interface. See Development environment for the full development setup.","locale":"en"},"12105":{"id":"/en/docs/installation-41","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-4-optional-portaudio-for-live-voice-conversion","content":"The **Live** page uses PortAudio through `sounddevice` to access sound cards.","locale":"en"},"12106":{"id":"/en/docs/installation-42","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-4-optional-portaudio-for-live-voice-conversion","content":"No additional installation is needed. The Windows package of `sounddevice` includes PortAudio (with ASIO support).","locale":"en"},"12107":{"id":"/en/docs/installation-43","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-4-optional-portaudio-for-live-voice-conversion","content":"No additional installation is needed. The macOS package of `sounddevice` includes PortAudio.","locale":"en"},"12108":{"id":"/en/docs/installation-44","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-4-optional-portaudio-for-live-voice-conversion","content":"The system PortAudio library is required. On Debian / Ubuntu:","locale":"en"},"12109":{"id":"/en/docs/installation-45","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-4-optional-portaudio-for-live-voice-conversion","content":"On other distributions, install the corresponding PortAudio package.","locale":"en"},"12110":{"id":"/en/docs/installation-46","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-4-optional-portaudio-for-live-voice-conversion","content":"PortAudio is not needed if you only convert files, separate audio and train models.","locale":"en"},"12111":{"id":"/en/docs/installation-47","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"Lists the versions of RVC Next, Python and major components such as torch, transformers, faiss-cpu, av, sounddevice and pymss. A component showing `not installed` indicates an incomplete installation.","locale":"en"},"12112":{"id":"/en/docs/installation-48","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"`doctor` performs a comprehensive check and offers recommendations:","locale":"en"},"12113":{"id":"/en/docs/installation-49","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"The data folder location;","locale":"en"},"12114":{"id":"/en/docs/installation-50","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"The torch and CUDA versions, the automatically selected compute device and precision, and each device's GPU memory and whether it is selected;","locale":"en"},"12115":{"id":"/en/docs/installation-51","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"Whether `ffmpeg` is found (optional; PyAV can decode without it);","locale":"en"},"12116":{"id":"/en/docs/installation-52","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"Whether audio devices are available (required for live voice conversion);","locale":"en"},"12117":{"id":"/en/docs/installation-53","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"The status and verification results of each asset (HuBERT, RMVPE, base models, separation models, etc.).","locale":"en"},"12118":{"id":"/en/docs/installation-54","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#step-5-verify-the-installation","content":"After a fresh installation, `doctor` reports that HuBERT and RMVPE are not installed and provides commands such as `rvc-next assets download hubert`. This is normal; the next page covers it. Both commands support `--json` output.","locale":"en"},"12119":{"id":"/en/docs/installation-55","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#next-step","content":"Continue to First run: start the web interface, download models and complete your first conversion.","locale":"en"},"12120":{"id":"/en/docs/quick-start","page_id":"/en/docs/quick-start","type":"page","content":"Overview","breadcrumbs":["RVC Next Documentation","Getting started"],"tags":[],"url":"/en/docs/quick-start","locale":"en"},"12121":{"id":"/en/docs/quick-start-0","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"RVC Next is an integrated rewrite of Retrieval-based-Voice-Conversion-WebUI (referred to below as the original RVC).","locale":"en"},"12122":{"id":"/en/docs/quick-start-1","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#what-rvc-next-can-do","content":"What RVC Next can do","locale":"en"},"12123":{"id":"/en/docs/quick-start-2","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#who-it-is-for","content":"Who it is for","locale":"en"},"12124":{"id":"/en/docs/quick-start-3","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#documentation-structure","content":"Documentation structure","locale":"en"},"12125":{"id":"/en/docs/quick-start-4","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#quick-start-path","content":"Quick-start path","locale":"en"},"12126":{"id":"/en/docs/quick-start-5","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"RVC Next is an integrated rewrite of Retrieval-based-Voice-Conversion-WebUI (referred to below as the “original RVC”). It brings conversion, live voice conversion, vocal separation, training and model management into **one application**: one local server, one web interface and one command-line tool, `rvc-next`.","locale":"en"},"12127":{"id":"/en/docs/quick-start-6","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"This section takes you from scratch: install RVC Next, start the web interface, download the required models and complete your first conversion with a demo voice.","locale":"en"},"12128":{"id":"/en/docs/quick-start-7","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#what-rvc-next-can-do","content":"Feature","locale":"en"},"12129":{"id":"/en/docs/quick-start-8","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#what-rvc-next-can-do","content":"Location in the interface","locale":"en"},"12130":{"id":"/en/docs/quick-start-9","page_id":"/en/docs/quick-start","tags":[],"typ