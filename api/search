ocs/development-31","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Core services","locale":"en"},"10281":{"id":"/en/docs/development-32","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"`rvc_next.core`: jobs, GPU memory management, assets, voice library and imports, audio files, conversion, separation, training, live voice conversion, settings, events and database","locale":"en"},"10282":{"id":"/en/docs/development-33","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"API and events","locale":"en"},"10283":{"id":"/en/docs/development-34","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"FastAPI routing conventions, uploads, security model, socket.io events and payloads, OpenAPI → TypeScript type generation and port selection","locale":"en"},"10284":{"id":"/en/docs/development-35","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Web UI","locale":"en"},"10285":{"id":"/en/docs/development-36","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Vue 3 frontend: directory structure, `ui/` components and MD3 motion, unified experience contract, data flow, layout rules, internationalisation, tests and adding a page","locale":"en"},"10286":{"id":"/en/docs/development-37","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"CLI implementation","locale":"en"},"10287":{"id":"/en/docs/development-38","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Typer factory, command registration, errors to exit codes, `--json`, foreground jobs and adding a command","locale":"en"},"10288":{"id":"/en/docs/development-39","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Assets and model repositories","locale":"en"},"10289":{"id":"/en/docs/development-40","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"`catalog.json` format, two download repositories, verification and resumable downloads, adding an asset, models found only in distribution packages","locale":"en"},"10290":{"id":"/en/docs/development-41","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Parity with the original","locale":"en"},"10291":{"id":"/en/docs/development-42","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Porting rules, golden tests, behaviour differences from the original and their reasons, torchaudio / torchfcpe ports","locale":"en"},"10292":{"id":"/en/docs/development-43","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"Tests and checks","locale":"en"},"10293":{"id":"/en/docs/development-44","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"`dev.py check`, pytest markers and environment variables, tiny models, test layout and CI","locale":"en"},"10294":{"id":"/en/docs/development-45","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#page-map","content":"If you are new to the code, read Development environment → Architecture → the layer relevant to your work.","locale":"en"},"10295":{"id":"/en/docs/development-46","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"RVC Next is a rewrite of Retrieval-based-Voice-Conversion-WebUI (called “the original” below, based on the local checkout at `81eed5e`, a heavily modified 2026 branch that replaces fairseq with `transformers` HuBERT, replaces UVR5 with PyMSS, and adds CUDA Graphs, multi-speaker training and a VST plugin). The original spreads its features across five entry points: the Gradio WebUI, a desktop live voice conversion GUI, a VST plugin, CLI scripts for each training stage, and the bundled PyMSS CLI. Each has its own settings, model selection and progress display. The rewrite combines them into one application: **Convert**, **Live**, **Separate**, **Train** and **Models**, behind one FastAPI server, one Vue 3 Web UI and one Typer CLI.","locale":"en"},"10296":{"id":"/en/docs/development-47","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"The code has three sources, each handled differently:","locale":"en"},"10297":{"id":"/en/docs/development-48","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"Source","locale":"en"},"10298":{"id":"/en/docs/development-49","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"What was taken","locale":"en"},"10299":{"id":"/en/docs/development-50","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"How it was handled","locale":"en"},"10300":{"id":"/en/docs/development-51","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"SD Model Hub (via Hanaikada)","locale":"en"},"10301":{"id":"/en/docs/development-52","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"Application skeleton: settings, event bus, SQLite database, security middleware, port binding, CLI factory, Web UI theme, `ui/` component library, motion system and rule tests","locale":"en"},"10302":{"id":"/en/docs/development-53","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"Renamed and reused; Hanaikada's `embed.py` (embedding in other applications) was left out because no host application needs to embed RVC Next","locale":"en"},"10303":{"id":"/en/docs/development-54","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"Original RVC","locale":"en"},"10304":{"id":"/en/docs/development-55","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"Synthesizer and discriminator networks, RMVPE, TorchGate, CUDA Graph cache, numerical code for offline / streaming / training pipelines","locale":"en"},"10305":{"id":"/en/docs/development-56","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"**Ported rather than rewritten**, with golden tests comparing against the original bit for bit so existing voices sound exactly the same (see Parity with the original)","locale":"en"},"10306":{"id":"/en/docs/development-57","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"torchaudio, torchfcpe","locale":"en"},"10307":{"id":"/en/docs/development-58","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"The windowed sinc resampler in `transforms.Resample`; FCPE inference path (mel frontend, convolution-only `CFNaiveMelPE`, decoders and loader)","locale":"en"},"10308":{"id":"/en/docs/development-59","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"Ported step by step to `engine/audio/sinc_resample.py` and `engine/f0/fcpe_model.py`; tests verify bit-identical results when the original libraries are installed. RVC Next therefore no longer depends on torchaudio (whose final release is 2.11) or torchfcpe","locale":"en"},"10309":{"id":"/en/docs/development-60","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#project-origins","content":"Orchestration, storage, process control and all user interfaces were written from scratch.","locale":"en"},"10310":{"id":"/en/docs/development-61","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#licence","content":"RVC Next is released under **GPL-3.0-only** (`LICENSE`, `license = \"GPL-3.0-only\"` in `pyproject.toml`), because its skeleton comes from the GPLv3 projects SD Model Hub and Hanaikada. Ported code retains its original licence notices, collected in `NOTICE`:","locale":"en"},"10311":{"id":"/en/docs/development-62","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#licence","content":"Original RVC: MIT;","locale":"en"},"10312":{"id":"/en/docs/development-63","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#licence","content":"torchaudio: BSD 2-Clause, with the full text also retained in `engine/audio/sinc_resample.py`;","locale":"en"},"10313":{"id":"/en/docs/development-64","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#licence","content":"FCPE / torchfcpe: MIT (its conformer comes from Diffusion-SVC, also MIT);","locale":"en"},"10314":{"id":"/en/docs/development-65","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#licence","content":"PyMSS is used as a dependency (MIT); sources for RMVPE, DDSP-SVC's SOLA crossfade and TorchGate are also credited there.","locale":"en"},"10315":{"id":"/en/docs/development-66","page_id":"/en/docs/development","tags":[],"type":"text","url":"/en/docs/development#licence","content":"Model weights downloaded at runtime (HuBERT, RMVPE, FCPE, base models, separation models and demo voices) have their own terms and are outside this repository's licence. When porting new code, record its source and licence both in the file header and in `NOTICE`.","locale":"en"},"10316":{"id":"/en/docs/first-run","page_id":"/en/docs/first-run","type":"page","content":"First run","breadcrumbs":["RVC Next Documentation","Getting started"],"tags":[],"url":"/en/docs/first-run","locale":"en"},"10317":{"id":"/en/docs/first-run-0","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run","content":"After installing RVC Next, follow the entire first-run process: start the web interface, learn where data is stored, download HuBERT and RMVPE for conversion, get a demo voice and complete a conversion. Each step includes both web interface and command-line instructions.","locale":"en"},"10318":{"id":"/en/docs/first-run-1","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#start-the-web-interface","content":"Start the web interface","locale":"en"},"10319":{"id":"/en/docs/first-run-2","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#data-folder","content":"Data folder","locale":"en"},"10320":{"id":"/en/docs/first-run-3","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#download-hubert-and-rmvpe","content":"Download HuBERT and RMVPE","locale":"en"},"10321":{"id":"/en/docs/first-run-4","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#get-a-demo-voice","content":"Get a demo voice","locale":"en"},"10322":{"id":"/en/docs/first-run-5","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#complete-your-first-conversion","content":"Complete your first conversion","locale":"en"},"10323":{"id":"/en/docs/first-run-6","page_id":"/en/docs/first-run","type":"heading","tags":[],"url":"/en/docs/first-run#next-steps","content":"Next steps","locale":"en"},"10324":{"id":"/en/docs/first-run-7","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"Run this in a terminal with the RVC Next environment activated:","locale":"en"},"10325":{"id":"/en/docs/first-run-8","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"Once the server starts, the terminal prints a line like:","locale":"en"},"10326":{"id":"/en/docs/first-run-9","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"The browser will open this address automatically shortly afterward. The default port is **7868** (separate from the original RVC's 7865). To stop the server, press ctrl+c in the terminal.","locale":"en"},"10327":{"id":"/en/docs/first-run-10","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"Common options for `rvc-next webui`:","locale":"en"},"10328":{"id":"/en/docs/first-run-11","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"Option","locale":"en"},"10329":{"id":"/en/docs/first-run-12","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"Purpose","locale":"en"},"10330":{"id":"/en/docs/first-run-13","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"`--port <port>`","locale":"en"},"10331":{"id":"/en/docs/first-run-14","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"First port to try, read from settings by default (7868); `0` picks any free port","locale":"en"},"10332":{"id":"/en/docs/first-run-15","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"`--strict-port` / `--no-strict-port`","locale":"en"},"10333":{"id":"/en/docs/first-run-16","page_id":"/en/docs/first-run","tags":[],"type":"text","url":"/en/docs/first-run#start-the-web-interface","content":"Fail instead of trying the next port when it is occupied (by default, it tries the next port and reports 