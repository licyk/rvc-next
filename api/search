age_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Option","locale":"en"},"11322":{"id":"/en/docs/guide-parameters-103","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Characteristics","locale":"en"},"11323":{"id":"/en/docs/guide-parameters-104","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Required download","locale":"en"},"11324":{"id":"/en/docs/guide-parameters-105","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"**pm (fast)**","locale":"en"},"11325":{"id":"/en/docs/guide-parameters-106","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Traditional Praat-based method, fastest and CPU-friendly; can mistrack singing, breathy voices and noisy recordings","locale":"en"},"11326":{"id":"/en/docs/guide-parameters-107","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"None","locale":"en"},"11327":{"id":"/en/docs/guide-parameters-108","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"**RMVPE (best)**","locale":"en"},"11328":{"id":"/en/docs/guide-parameters-109","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Neural pitch model, most accurate and noise-resistant, suitable for singing; the default","locale":"en"},"11329":{"id":"/en/docs/guide-parameters-110","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"RMVPE (about 173 MB)","locale":"en"},"11330":{"id":"/en/docs/guide-parameters-111","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"**FCPE**","locale":"en"},"11331":{"id":"/en/docs/guide-parameters-112","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Lightweight neural pitch model, fast with a small model file","locale":"en"},"11332":{"id":"/en/docs/guide-parameters-113","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"FCPE (about 41 MB)","locale":"en"},"11333":{"id":"/en/docs/guide-parameters-114","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"**CREPE (smooth, slow)**","locale":"en"},"11334":{"id":"/en/docs/guide-parameters-115","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"The neural pitch tracker many RVC voices were trained with; a smooth contour on singing, but about real time on a CPU","locale":"en"},"11335":{"id":"/en/docs/guide-parameters-116","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"CREPE (about 85 MB)","locale":"en"},"11336":{"id":"/en/docs/guide-parameters-117","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"**CREPE tiny (fast)**","locale":"en"},"11337":{"id":"/en/docs/guide-parameters-118","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"CREPE's small model: much faster, a little less accurate","locale":"en"},"11338":{"id":"/en/docs/guide-parameters-119","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"CREPE tiny (about 2 MB)","locale":"en"},"11339":{"id":"/en/docs/guide-parameters-120","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"**SwiftF0 (fast)**","locale":"en"},"11340":{"id":"/en/docs/guide-parameters-121","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"A very small, very fast neural pitch model (about 100× real time on one CPU core) that its benchmark puts level with RMVPE, up to 2093 Hz; a repair step from Applio lifts notes it briefly reads an octave low","locale":"en"},"11341":{"id":"/en/docs/guide-parameters-122","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"None (comes with RVC Next)","locale":"en"},"11342":{"id":"/en/docs/guide-parameters-123","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Suggestions:","locale":"en"},"11343":{"id":"/en/docs/guide-parameters-124","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Keep **RMVPE** in most cases.","locale":"en"},"11344":{"id":"/en/docs/guide-parameters-125","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Without a GPU, if speed matters, try **SwiftF0**, **FCPE** or **CREPE tiny**, or **pm** for clean speech.","locale":"en"},"11345":{"id":"/en/docs/guide-parameters-126","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"For a voice trained with CREPE pitch (common among voices shared online), **CREPE** may follow its training most closely; with a GPU it is fast enough for Live too.","locale":"en"},"11346":{"id":"/en/docs/guide-parameters-127","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Sudden off-key notes, voice breaks or erratic pitch usually indicate pitch-tracking errors; switching to **RMVPE** often resolves them.","locale":"en"},"11347":{"id":"/en/docs/guide-parameters-128","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"If the selected method's model is not downloaded, the run button is replaced by “**Needs RMVPE**” (or the method's other model) and a **Download** button.","locale":"en"},"11348":{"id":"/en/docs/guide-parameters-129","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#f0","content":"Voices with **no pitch guidance** (trained with pitch guidance disabled) do not use pitch. This row is dimmed, the selected method has no effect, and no pitch model download is required.","locale":"en"},"11349":{"id":"/en/docs/guide-parameters-130","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"> Shift in semitones: +12 is an octave up. Use about +12 from a male to a female voice.","locale":"en"},"11350":{"id":"/en/docs/guide-parameters-131","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Shift the input pitch by a number of semitones before passing it to the voice. This is the most commonly adjusted parameter:","locale":"en"},"11351":{"id":"/en/docs/guide-parameters-132","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Situation","locale":"en"},"11352":{"id":"/en/docs/guide-parameters-133","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Suggested value","locale":"en"},"11353":{"id":"/en/docs/guide-parameters-134","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Male input, female voice model","locale":"en"},"11354":{"id":"/en/docs/guide-parameters-135","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Around +12 (sometimes +8 to +12 sounds more natural)","locale":"en"},"11355":{"id":"/en/docs/guide-parameters-136","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Female input, male voice model","locale":"en"},"11356":{"id":"/en/docs/guide-parameters-137","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Around −12","locale":"en"},"11357":{"id":"/en/docs/guide-parameters-138","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Same gender","locale":"en"},"11358":{"id":"/en/docs/guide-parameters-139","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"0, then fine-tune by ±1 to ±3 as needed","locale":"en"},"11359":{"id":"/en/docs/guide-parameters-140","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Match the original song's key for a cover","locale":"en"},"11360":{"id":"/en/docs/guide-parameters-141","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"Use mainly multiples of 12 to suit the voice's range and avoid going out of key with the accompaniment","locale":"en"},"11361":{"id":"/en/docs/guide-parameters-142","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"The goal is to keep the shifted pitch within **the range of the voice's training data**. Straying too far can make the voice sound weak, off-key or distorted.","locale":"en"},"11362":{"id":"/en/docs/guide-parameters-143","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"If **Separate first** and **Add accompaniment back** are enabled, the accompaniment is not transposed. Use **Pitch** 0 or ±12 where possible; otherwise, the vocals and accompaniment will be in different keys.","locale":"en"},"11363":{"id":"/en/docs/guide-parameters-144","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#pitch","content":"The interface adjusts in steps of 1 semitone; the command line and API accept decimals, such as `--pitch 1.5`. **Pitch** affects only voices with pitch guidance.","locale":"en"},"11364":{"id":"/en/docs/guide-parameters-145","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#formant","content":"> Shifts the vocal tract colour without changing pitch.","locale":"en"},"11365":{"id":"/en/docs/guide-parameters-146","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#formant","content":"Formants affect how old the speaker sounds. **Positive values** raise formants, making the voice thinner, brighter and younger; **negative values** lower them, making the voice fuller and deeper. Pitch stays the same.","locale":"en"},"11366":{"id":"/en/docs/guide-parameters-147","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#formant","content":"In cross-gender conversion, if the voice still does not sound right after adjusting **Pitch**, shift **Formant** slightly in the same direction, such as +0.5 to +1 for male-to-female conversion;","locale":"en"},"11367":{"id":"/en/docs/guide-parameters-148","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#formant","content":"Avoid large adjustments: ±2 is already a pronounced change, and excessive shifts sound unnatural.","locale":"en"},"11368":{"id":"/en/docs/guide-parameters-149","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#formant","content":"The original RVC offers formant shifting only in live voice conversion. RVC Next applies the same method to file conversion as well; at **Formant** 0, the computation is identical to the original.","locale":"en"},"11369":{"id":"/en/docs/guide-parameters-150","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#index-rate","content":"> How much of the voice's own timbre is drawn from its index.","locale":"en"},"11370":{"id":"/en/docs/guide-parameters-151","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#index-rate","content":"A voice's index (`.index` file) stores features from its training data. During conversion, RVC finds the features closest to the input and mixes them in at this ratio, making the result closer to the training voice.","locale":"en"},"11371":{"id":"/en/docs/guide-parameters-152","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#index-rate","content":"**Higher**: the voice sounds closer to the training data, including the training speaker's accent and articulation; a poor index or too little data can introduce noise, muffling or unclear articulation;","locale":"en"},"11372":{"id":"/en/docs/guide-parameters-153","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#index-rate","content":"**Lower**: preserves more of the input's pronunciation, with clearer articulation but less voice similarity;","locale":"en"},"11373":{"id":"/en/docs/guide-parameters-154","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#index-rate","content":"**0**: does not use the index at all.","locale":"en"},"11374":{"id":"/en/docs/guide-parameters-155","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#index-rate","content":"Start at the default 0.75; lower to 0.3–0.6 if pronunciation is muffled or noisy.","locale":"en"},"11375":{"id":"/en/docs/guide-parameters-156","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#index-rate","content":"If the voice has no attached index, this slider is dimmed and shows “This voice has no index, so index strength has no effect. Attach one in Models.” See Model management for attaching indexes. Multi-speaker voices can have a separate index for each speaker; conversion uses the selected speaker's index.","locale":"en"},"11376":{"id":"/en/docs/guide-parameters-157","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#protect","content":"> Keeps breaths and consonants clear where the input has no pitch; 0.5 turns it off.","locale":"en"},"11377":{"id":"/en/docs/guide-parameters-158","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#protect","content":"Unvoiced consonants (such as s, sh, t and k) and breaths have no pitch. Replacing them with voice features can cause robotic sounds or tearing artifacts. Consonant protection preserves more of the input's features in these unpitched regions. What it holds back is the index: with **Index strength** at 0, or a voice without an index, it changes nothing.","locale":"en"},"11378":{"id":"/en/docs/guide-parameters-159","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#protect","content":"**Lower values give stronger protection**; **0.5 disables protection**;","locale":"en"},"11379":{"id":"/en/docs/guide-parameters-160","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#protect","content":"The default 0.33 suits most cases;","locale":"en"},"11380":{"id":"/en/docs/guide-parameters-161","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#protect","content":"If sibilants or breaths have tearing or electronic artifacts, lower it to 0.2–0.3;","locale":"en"},"11381":{"id":"/en/docs/guide-parameters-162","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#protect","content":"Very strong protection (close to 0) makes these regions sound more like the original and weakens the effect of **Index strength**.","locale":"en"},"11382":{"id":"/en/docs/guide-parameters-163","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#protect","content":"Voices with **no pitch guidance** do not use this parameter; the slider is dimmed and shows “This voice has no pitch guidance, so this has no effect.” With **Frames without pitch** set to **Fill in (RVC 2026)** it has no effect either, and the slider says so.","locale":"en"},"11383":{"id":"/en/docs/guide-parameters-164","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"Under **Pitch details**. The pitch method finds no pitch in breaths and unvoiced consonants; this choice says what happens there:","locale":"en"},"11384":{"id":"/en/docs/guide-parameters-165","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"Choice","locale":"en"},"11385":{"id":"/en/docs/guide-parameters-166","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"`--unvoiced`","locale":"en"},"11386":{"id":"/en/docs/guide-parameters-167","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"What it does","locale":"en"},"11387":{"id":"/en/docs/guide-parameters-168","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"**Protect them** (default)","locale":"en"},"11388":{"id":"/en/docs/guide-parameters-169","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"`protect`","locale":"en"},"11389":{"id":"/en/docs/guide-parameters-170","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"The pitch is filled in from the neighbouring frames, and **Consonant protection** applies to these frames.","locale":"en"},"11390":{"id":"/en/docs/guide-parameters-171","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"**No pitch (classic RVC)**","locale":"en"},"11391":{"id":"/en/docs/guide-parameters-172","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"`zero`","locale":"en"},"11392":{"id":"/en/docs/guide-parameters-173","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"These frames also get no pitch, so the voice makes noise there instead of a tone, as classic RVC and Applio convert. Most voices shared online were trained this way and may sound cleaner with it.","locale":"en"},"11393":{"id":"/en/docs/guide-parameters-174","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"**Fill in (RVC 2026)**","locale":"en"},"11394":{"id":"/en/docs/guide-parameters-175","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"`original`","locale":"en"},"11395":{"id":"/en/docs/guide-parameters-176","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"The rule of the RVC package RVC Next follows: the pitch is filled in and consonant protection has no effect.","locale":"en"},"11396":{"id":"/en/docs/guide-parameters-177","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#unvoiced","content":"RVC 2026 fills in the missing pitch before consonant protection looks for it, so it never finds any and protection never applies. **Protect them** keeps the filled-in pitch (what voices trained with RVC 2026 or RVC Next expect) but takes the frames from the pitch method's own verdict. Live applies the same choice.","locale":"en"},"11397":{"id":"/en/docs/guide-parameters-178","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"Under **Pitch details**; for **RMVPE**, and only in Convert (Live leaves it out: it would double the pitch time of every block).","locale":"en"},"11398":{"id":"/en/docs/guide-parameters-179","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"RMVPE was trained on singing that ends near C6 (about 1040 Hz). Above that it reports the note an octave low, or an octave and a fifth low, with full confidence, and the converted voice sings it there. **Correct to the true pitch** runs RMVPE a second time on the audio played an octave lower, where it reads correctly, and uses that pass to put each frame back in its octave, keeping the first pass's finer contour where the two agree. Frames below 460 Hz are never changed, so speech and most singing come out exactly as before; pitch detection takes about three times as long.","locale":"en"},"11399":{"id":"/en/docs/guide-parameters-180","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"Choice","locale":"en"},"11400":{"id":"/en/docs/guide-parameters-181","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"`--high-register`","locale":"en"},"11401":{"id":"/en/docs/guide-parameters-182","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"What it does","locale":"en"},"11402":{"id":"/en/docs/guide-parameters-183","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"**As detected** (default)","locale":"en"},"11403":{"id":"/en/docs/guide-parameters-184","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"`off`","locale":"en"},"11404":{"id":"/en/docs/guide-parameters-185","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"RMVPE's result, as in the original.","locale":"en"},"11405":{"id":"/en/docs/guide-parameters-186","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"**Correct to the true pitch**","locale":"en"},"11406":{"id":"/en/docs/guide-parameters-187","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"`true_pitch`","locale":"en"},"11407":{"id":"/en/docs/guide-parameters-188","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"Notes up to **Highest corrected pitch** (default 1250 Hz) get their true pitch; higher ones stay an octave low, because voices trained on RMVPE pitch rarely produce anything above it.","locale":"en"},"11408":{"id":"/en/docs/guide-parameters-189","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"**Correct, an octave down**","locale":"en"},"11409":{"id":"/en/docs/guide-parameters-190","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"`fold`","locale":"en"},"11410":{"id":"/en/docs/guide-parameters-191","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"Fixes only notes read in the wrong pitch class, writing them an octave below the truth, so every note stays in the range the voice was trained on.","locale":"en"},"11411":{"id":"/en/docs/guide-parameters-192","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#high-register","content":"The corrector comes from Applio.","locale":"en"},"11412":{"id":"/en/docs/guide-parameters-193","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"Under **Pitch details**; Convert only (in Live the key would jump from block to block). It works out how far the input's usual pitch (the median of its voiced frames) is from the voice's, and shifts by that, on top of **Pitch**:","locale":"en"},"11413":{"id":"/en/docs/guide-parameters-194","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"Choice","locale":"en"},"11414":{"id":"/en/docs/guide-parameters-195","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"`--auto-pitch`","locale":"en"},"11415":{"id":"/en/docs/guide-parameters-196","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"Shift","locale":"en"},"11416":{"id":"/en/docs/guide-parameters-197","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"**Off** (default)","locale":"en"},"11417":{"id":"/en/docs/guide-parameters-198","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"`off`","locale":"en"},"11418":{"id":"/en/docs/guide-parameters-199","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"None","locale":"en"},"11419":{"id":"/en/docs/guide-parameters-200","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"**To the nearest semitone**","locale":"en"},"11420":{"id":"/en/docs/guide-parameters-201","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"`semitone`","locale":"en"},"11421":{"id":"/en/docs/guide-parameters-202","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"The interval rounded to a semitone (at most two octaves). Good for speech.","locale":"en"},"11422":{"id":"/en/docs/guide-parameters-203","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"**By whole octaves**","locale":"en"},"11423":{"id":"/en/docs/guide-parameters-204","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"`octave`","locale":"en"},"11424":{"id":"/en/docs/guide-parameters-205","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"The interval rounded to whole octaves, so a song stays in its key. Good for singing.","locale":"en"},"11425":{"id":"/en/docs/guide-parameters-206","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#auto-pitch","content":"**Aim at** is the target pitch. At 0 it is the voice's own: rvc-next measures the training data's median pitch when it trains a voice and shows it in the voice's **About** as **Training pitch (median)**. Voices that do not record it (most downloaded ones) aim at 155 Hz, a lower voice; set about 255 Hz for a higher one. The job's log says which key it chose. From Applio's \"proposed pitch\", which works per chunk; here the key is chosen once for the whole file.","locale":"en"},"11426":{"id":"/en/docs/guide-parameters-207","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#autotune","content":"Under **Pitch details**; Convert and Live. Pulls every voiced frame towards the nearest semitone of A4 = 440 Hz tuning: 1 snaps each frame to the note (the robotic \"autotune\" sound), 0.3–0.6 tightens the pitch while keeping some vibrato, 0 leaves it alone. Breaths and consonants are never given a note. It tunes the pitch you hear, after **Pitch**, **Automatic key** and **Formant**.","locale":"en"},"11427":{"id":"/en/docs/guide-parameters-208","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#rms-mix","content":"> 0 follows the input's loudness, 1 keeps the converted loudness.","locale":"en"},"11428":{"id":"/en/docs/guide-parameters-209","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#rms-mix","content":"Controls which loudness variations (loudness envelope) the output follows:","locale":"en"},"11429":{"id":"/en/docs/guide-parameters-210","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#rms-mix","content":"**0**: output volume variations fully follow the input, useful for singing where you want to preserve the original dynamics;","locale":"en"},"11430":{"id":"/en/docs/guide-parameters-211","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#rms-mix","content":"**1**: keep the model-generated loudness without adjustment;","locale":"en"},"11431":{"id":"/en/docs/guide-parameters-212","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#rms-mix","content":"Default **0.25**: mainly follows the input's variations.","locale":"en"},"11432":{"id":"/en/docs/guide-parameters-213","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#rms-mix","content":"Lower it to preserve more of the original dynamics; raise it to stay closer to the model's own loudness. If unsure, keep the default.","locale":"en"},"11433":{"id":"/en/docs/guide-parameters-214","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#speaker","content":"Multi-speaker voices (with speaker information in the model file) add a **Speaker** dropdown beneath the voice picker, listing speakers by name and number. Selecting a new voice automatically selects its first speaker.","locale":"en"},"11434":{"id":"/en/docs/guide-parameters-215","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#speaker","content":"Single-speaker voices do not show this dropdown and use ID 0. Speaker names can be edited in voice details; see Model management. Specify one on the command line with `--speaker <id>`.","locale":"en"},"11435":{"id":"/en/docs/guide-parameters-216","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#presets","content":"A preset is a saved set of voice parameters (excluding speaker). Each preset either **belongs to one voice** or is shared by **all voices**.","locale":"en"},"11436":{"id":"/en/docs/guide-parameters-217","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#each-voices-default-preset","content":"Every voice has a **default preset**, created automatically on import and named `Default`, with initial values from `convert.default_params` in settings (the defaults in the table above).","locale":"en"},"11437":{"id":"/en/docs/guide-parameters-218","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#each-voices-default-preset","content":"**Selecting a voice on any page automatically loads its default preset into the parameter panel** (the speaker is unchanged). Save your usual pitch, index strength and other values in the default preset to make the voice ready to use as soon as you select it in **Convert** or **Live**.","locale":"en"},"11438":{"id":"/en/docs/guide-parameters-219","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#each-voices-default-preset","content":"To edit the default preset, open **Models › Voices**, click a voice to open its details, adjust the **Default parameters** section and click **Save**.","locale":"en"},"11439":{"id":"/en/docs/guide-parameters-220","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#apply-a-preset","content":"Click **Presets** at the top right of the parameter panel. The menu lists:","locale":"en"},"11440":{"id":"/en/docs/guide-parameters-221","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#apply-a-preset","content":"Presets for the current voice, with “· default” on the default preset;","locale":"en"},"11441":{"id":"/en/docs/guide-parameters-222","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#apply-a-preset","content":"Presets shared by all voices, labeled “· all voices”;","locale":"en"},"11442":{"id":"/en/docs/guide-parameters-223","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#apply-a-preset","content":"**Save as preset** as the last item.","locale":"en"},"11443":{"id":"/en/docs/guide-parameters-224","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#apply-a-preset","content":"Click a preset to apply its parameters (the speaker is unchanged); its name appears in a notification at the bottom of the screen.","locale":"en"},"11444":{"id":"/en/docs/guide-parameters-225","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#save-a-preset","content":"After adjusting parameters, click **Presets** › **Save as preset**.","locale":"en"},"11445":{"id":"/en/docs/guide-parameters-226","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#save-a-preset","content":"Enter a name in **Preset name**.","locale":"en"},"11446":{"id":"/en/docs/guide-parameters-227","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-parameters#save-a-preset","content":"Check **For this voice only** to make the preset belong to the current voice; uncheck it to save a preset shared by all voices.","locale":"en"},"11447":{"id":"/en/docs/guide-parameters-228","page_id":"/en/docs/guide-parameters","tags":[],"type":"text","url":"/en/docs/guide-paramet