g-357","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"`live.devices.*`, `live.stream.*`","locale":"en"},"7708":{"id":"/en/docs/cli-config-358","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"Next live voice conversion start; changing block length, crossfade, or context while running rebuffers without reloading the model","locale":"en"},"7709":{"id":"/en/docs/cli-config-359","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"Other settings","locale":"en"},"7710":{"id":"/en/docs/cli-config-360","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#which-changes-require-a-restart","content":"Next use","locale":"en"},"7711":{"id":"/en/docs/cli-config-361","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"Data directory locations:","locale":"en"},"7712":{"id":"/en/docs/cli-config-362","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"System","locale":"en"},"7713":{"id":"/en/docs/cli-config-363","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"Default location","locale":"en"},"7714":{"id":"/en/docs/cli-config-364","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"Windows","locale":"en"},"7715":{"id":"/en/docs/cli-config-365","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"`%APPDATA%\\rvc-next`","locale":"en"},"7716":{"id":"/en/docs/cli-config-366","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"macOS","locale":"en"},"7717":{"id":"/en/docs/cli-config-367","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"`~/Library/Application Support/rvc-next`","locale":"en"},"7718":{"id":"/en/docs/cli-config-368","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"Linux","locale":"en"},"7719":{"id":"/en/docs/cli-config-369","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"`$XDG_DATA_HOME/rvc-next`, or `~/.local/share/rvc-next` if unset","locale":"en"},"7720":{"id":"/en/docs/cli-config-370","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"Use `RVC_NEXT_DATA_DIR` or `rvc-next webui --data-dir` to choose another location. `data_dir` in `rvc-next config show` displays the current directory; in the Web UI, it appears as **Data folder** under **Settings** › **About**.","locale":"en"},"7721":{"id":"/en/docs/cli-config-371","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"Folders are the source of truth for the voice library: the database voice list is only a cache and can be rebuilt from `models/` and original RVC installations. Experiments are folders, not database entries.","locale":"en"},"7722":{"id":"/en/docs/cli-config-372","page_id":"/en/docs/cli-config","tags":[],"type":"text","url":"/en/docs/cli-config#data-dir","content":"To reset all settings to defaults, stop the server, then delete or rename `settings.toml` (`rvc-next config path` shows its location). The voice library, experiments, and results are unaffected. Values set by environment variables still apply.","locale":"en"},"7723":{"id":"/en/docs/cli","page_id":"/en/docs/cli","type":"page","content":"Overview","breadcrumbs":["RVC Next Documentation","Command line"],"tags":[],"url":"/en/docs/cli","locale":"en"},"7724":{"id":"/en/docs/cli-0","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#commands-at-a-glance","content":"Commands at a glance","locale":"en"},"7725":{"id":"/en/docs/cli-1","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#differences-from-the-web-ui","content":"Differences from the Web UI","locale":"en"},"7726":{"id":"/en/docs/cli-2","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#output-format-and---json","content":"Output format and `--json`","locale":"en"},"7727":{"id":"/en/docs/cli-3","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#exit-codes","content":"Exit codes","locale":"en"},"7728":{"id":"/en/docs/cli-4","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#debug-logs","content":"Debug logs","locale":"en"},"7729":{"id":"/en/docs/cli-5","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#shell-completion","content":"Shell completion","locale":"en"},"7730":{"id":"/en/docs/cli-6","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#common-workflows","content":"Common workflows","locale":"en"},"7731":{"id":"/en/docs/cli-7","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#initial-preparation","content":"Initial preparation","locale":"en"},"7732":{"id":"/en/docs/cli-8","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#convert-a-folder","content":"Convert a folder","locale":"en"},"7733":{"id":"/en/docs/cli-9","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#vocal-separation","content":"Vocal separation","locale":"en"},"7734":{"id":"/en/docs/cli-10","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#train-a-voice-from-scratch","content":"Train a voice from scratch","locale":"en"},"7735":{"id":"/en/docs/cli-11","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#import-models","content":"Import models","locale":"en"},"7736":{"id":"/en/docs/cli-12","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#live-voice-conversion","content":"Live voice conversion","locale":"en"},"7737":{"id":"/en/docs/cli-13","page_id":"/en/docs/cli","type":"heading","tags":[],"url":"/en/docs/cli#next-steps","content":"Next steps","locale":"en"},"7738":{"id":"/en/docs/cli-14","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli","content":"The `rvc-next` command line handles the same operations as the Web UI: conversion, vocal separation, training, live voice conversion, model and asset management, presets, job queries, and settings. Both call the same core services (one core method per operation), so the command line offers the same capabilities as the interface, and its `--json` output is identical to the JSON returned by the API.","locale":"en"},"7739":{"id":"/en/docs/cli-15","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli","content":"This page covers shared command-line conventions and common workflows. For every option of each command, see Command reference; for settings and environment variables, see Configuration and environment variables.","locale":"en"},"7740":{"id":"/en/docs/cli-16","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#commands-at-a-glance","content":"Add `--help` at any level to see help. Entering just a group name (such as `rvc-next model`) also shows that group's help.","locale":"en"},"7741":{"id":"/en/docs/cli-17","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#differences-from-the-web-ui","content":"**Jobs run in the foreground.** `convert`, `separate`, `train run`, `assets download`, `model merge`, and similar commands create a job and run it in the current terminal until it finishes, with a progress bar on stderr. Press ctrl+c to cancel the job; the exit code is 130.","locale":"en"},"7742":{"id":"/en/docs/cli-18","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#differences-from-the-web-ui","content":"**No server needs to be running.** Each command opens the data directory (settings, database, and models) itself and closes it when finished. Command-line jobs are also recorded in the database, so `rvc-next jobs list` shows all jobs on this machine, including those from a running server. Likewise, the Web UI's **Jobs** panel shows jobs run from the command line.","locale":"en"},"7743":{"id":"/en/docs/cli-19","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#differences-from-the-web-ui","content":"**The command line is trusted.** The Web UI can only open server files inside **Folders the browser may open** (`paths.browse_roots`), while the command line can use any path (see Remote access and security).","locale":"en"},"7744":{"id":"/en/docs/cli-20","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#differences-from-the-web-ui","content":"**A voice can be a direct `.pth` path.** `convert --voice` accepts a voice ID, name, or `.pth` file path. When using a path, you can also specify an index with `--index`; these temporary voices do not appear in the voice library list.","locale":"en"},"7745":{"id":"/en/docs/cli-21","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#differences-from-the-web-ui","content":"`rvc-next config set` writes directly to `settings.toml`. A running server picks up the change within about 1 second, and open Web UI sessions refresh accordingly. Subsequent saves from the Web UI merge with the file's current contents without overwriting command-line changes. A few settings (such as the port and listening address) still require a server restart.","locale":"en"},"7746":{"id":"/en/docs/cli-22","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#output-format-and---json","content":"List and query commands print tables by default. Add `--json` to print JSON with the same structure as the corresponding API response, suitable for scripts:","locale":"en"},"7747":{"id":"/en/docs/cli-23","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#output-format-and---json","content":"Progress bars appear only when stderr is a terminal and are disabled in `--json` mode, so redirecting stdout never mixes in progress information.","locale":"en"},"7748":{"id":"/en/docs/cli-24","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"When a command fails, the log prints an error message and the exit code indicates the error category (defined in `rvc_next/core/errors.py`):","locale":"en"},"7749":{"id":"/en/docs/cli-25","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Exit code","locale":"en"},"7750":{"id":"/en/docs/cli-26","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Meaning","locale":"en"},"7751":{"id":"/en/docs/cli-27","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Typical cases","locale":"en"},"7752":{"id":"/en/docs/cli-28","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"0","locale":"en"},"7753":{"id":"/en/docs/cli-29","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Success","locale":"en"},"7754":{"id":"/en/docs/cli-30","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"1","locale":"en"},"7755":{"id":"/en/docs/cli-31","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"General error","locale":"en"},"7756":{"id":"/en/docs/cli-32","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Unclassified internal error; answering \"no\" to `model remove`","locale":"en"},"7757":{"id":"/en/docs/cli-33","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"2","locale":"en"},"7758":{"id":"/en/docs/cli-34","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Not found (`not_found`)","locale":"en"},"7759":{"id":"/en/docs/cli-35","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Voice, job, experiment, or file does not exist. Note: Click also exits with 2 for invalid command-line arguments (unknown options or out-of-range values)","locale":"en"},"7760":{"id":"/en/docs/cli-36","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"3","locale":"en"},"7761":{"id":"/en/docs/cli-37","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Conflict or busy (`conflict`, `busy`)","locale":"en"},"7762":{"id":"/en/docs/cli-38","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Name already exists; a stage of the same experiment is running; `webui` cannot find an available port; `model import` has indexes whose pairing is uncertain","locale":"en"},"7763":{"id":"/en/docs/cli-39","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"4","locale":"en"},"7764":{"id":"/en/docs/cli-40","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Invalid input (`invalid_input`, `invalid_path`, `invalid_model`)","locale":"en"},"7765":{"id":"/en/docs/cli-41","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Parameter out of range, path not allowed, `.pth` is not an RVC model; a `webui` certificate file does not exist","locale":"en"},"7766":{"id":"/en/docs/cli-42","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"7","locale":"en"},"7767":{"id":"/en/docs/cli-43","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"Missing asset (`asset_missing`)","locale":"en"},"7768":{"id":"/en/docs/cli-44","page_id":"/en/docs/cli","tags":[],"type":"text","url":"/en/docs/cli#exit-codes","content":"HuBERT, a pitch model (RMVPE, FCPE, CREPE) or a base model