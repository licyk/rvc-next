":"text","url":"/en/docs/guide-separate#presets","content":"Separate vocals and accompaniment more thoroughly (BS-RoFormer, SDR 12.98)","locale":"en"},"11614":{"id":"/en/docs/guide-separate-31","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`vocals`, `instrumental`","locale":"en"},"11615":{"id":"/en/docs/guide-separate-32","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Separation: Vocals, aggressive","locale":"en"},"11616":{"id":"/en/docs/guide-separate-33","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"**Remove reverb**","locale":"en"},"11617":{"id":"/en/docs/guide-separate-34","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`dereverb`","locale":"en"},"11618":{"id":"/en/docs/guide-separate-35","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Remove reverb and echo from vocals (Mel-RoFormer, SDR 18.81)","locale":"en"},"11619":{"id":"/en/docs/guide-separate-36","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`noreverb`, `reverb`","locale":"en"},"11620":{"id":"/en/docs/guide-separate-37","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"Separation: Remove reverb","locale":"en"},"11621":{"id":"/en/docs/guide-separate-38","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"**Remove reverb, aggressive**","locale":"en"},"11622":{"id":"/en/docs/guide-separate-39","page_id":"/en/docs/guide-separate","tags":[],"type":"text","url":"/en/docs/guide-separate#presets","content":"`dereverb-aggressive`","locale":"en"},"11623":{"id":"/en/docs/guide-separate-40","page_id":"/en/docs/guide-separ