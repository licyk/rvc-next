evelopment-api#events-and-payloads","content":"`devices_changed`","locale":"en"},"7987":{"id":"/en/docs/development-api-189","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"`devices: DeviceList`","locale":"en"},"7988":{"id":"/en/docs/development-api-190","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"When re-enumeration finds a change","locale":"en"},"7989":{"id":"/en/docs/development-api-191","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"Write to `keys.liveDevices`","locale":"en"},"7990":{"id":"/en/docs/development-api-192","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"`compute_changed`","locale":"en"},"7991":{"id":"/en/docs/development-api-193","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"`usage: ComputeUsage`","locale":"en"},"7992":{"id":"/en/docs/development-api-194","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"Compute service: GPU memory release, job or Live state changes","locale":"en"},"7993":{"id":"/en/docs/development-api-195","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"Write to `keys.computeUsage`","locale":"en"},"7994":{"id":"/en/docs/development-api-196","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"`settings_changed`","locale":"en"},"7995":{"id":"/en/docs/development-api-197","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"`keys` (changed dotted keys)","locale":"en"},"7996":{"id":"/en/docs/development-api-198","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"Any settings change (API, CLI, direct edits to `settings.toml`)","locale":"en"},"7997":{"id":"/en/docs/development-api-199","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"Invalidate settings and `meta`","locale":"en"},"7998":{"id":"/en/docs/development-api-200","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"Not all IDs in `models_changed` are voice IDs: the index inbox sends `index:<id>`, base models send `base:<slug>`, and imported separation models send `user-<slug>` (also their separation preset ID). The frontend currently invalidates details by ID without distinguishing types; use the prefix when a distinction is needed.","locale":"en"},"7999":{"id":"/en/docs/development-api-201","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-and-payloads","content":"`live_stats` (10 Hz), `train_metrics`, and job progress live in Pinia stores rather than the TanStack Query cache: each `setQueryData` notifies all observers and compares data for structural sharing, so frequent writes would repeatedly recompute unrelated components. The cache holds only state that REST can fetch again; see Web UI.","locale":"en"},"8000":{"id":"/en/docs/development-api-202","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-in-openapi","content":"After FastAPI generates its schema, `RvcNextAPI.openapi()` in `api/openapi.py` adds each event class's JSON Schema (`mode=\"serialization\"`) to `components.schemas`, promotes nested `$defs` to peer components, and adds a `ServerEvents` object: property names are event names, and values reference event schemas. Components are sorted by name for stable output.","locale":"en"},"8001":{"id":"/en/docs/development-api-203","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#events-in-openapi","content":"Socket payloads and REST thus share one type source: the frontend `ServerEvents` type (`api/types.ts`) derives directly from the generated schema, so `job` in `socket.on('job_updated', ({ job }) => …)` has type `Job`. `tests/api/test_api.py::test_openapi_lists_events` checks that events appear in the schema.","locale":"en"},"8002":{"id":"/en/docs/development-api-204","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"`python scripts/dev.py typegen` does three things:","locale":"en"},"8003":{"id":"/en/docs/development-api-205","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"Run `scripts/generate_openapi.py`: call `build_services()` in a temporary data directory with an empty `environ`, then `create_app(serve_ui=False)`, and print `app.openapi()`. It neither starts a server nor reads user settings, so the result is identical on any machine.","locale":"en"},"8004":{"id":"/en/docs/development-api-206","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"Extract `VoiceParamsModel` and `StreamParamsModel` (`PARAM_MODELS`) from the schema, writing each field's `type`, `default`, `minimum`/`maximum`, `enum`, and `description` to `PARAM_SPECS` in `src/api/paramSpecs.ts`. openapi-typescript only generates types, while parameter panels need actual numbers; this step gives slider ranges, defaults, and help text one source: field constraints in `core/params.py`.","locale":"en"},"8005":{"id":"/en/docs/development-api-207","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"Generate `src/api/schema.d.ts` with openapi-typescript. `--default-non-nullable false` keeps **request** fields with defaults optional (clients may omit them).","locale":"en"},"8006":{"id":"/en/docs/development-api-208","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"Both generated files are committed. `typegen-check` (part of `dev.py check`, also run in CI) regenerates them and runs `git diff --exit-code`; an API change without regeneration fails.","locale":"en"},"8007":{"id":"/en/docs/development-api-209","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"Three settings affect type shapes:","locale":"en"},"8008":{"id":"/en/docs/development-api-210","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"`Record` sets `json_schema_serialization_defaults_required=True`: fields with defaults always appear in **responses**, so the schema marks them required instead of generating `?` everywhere.","locale":"en"},"8009":{"id":"/en/docs/development-api-211","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"`separate_input_output_schemas=False`: most models produce one schema rather than separate `-Input`/`-Output` schemas. FastAPI still splits `Dataset`, `FitSettings`, and `SpeakerEntry`; `api/types.ts` reads the `-Output` shape and uses `-Input` for sending.","locale":"en"},"8010":{"id":"/en/docs/development-api-212","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#generating-typescript-from-the-schema","content":"Event schemas use serialization mode, but event fields with defaults may still be optional in TypeScript; comments in `api/types.ts` record this (the server always sends them).","locale":"en"},"8011":{"id":"/en/docs/development-api-213","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#static-pages","content":"`api/static.py`:","locale":"en"},"8012":{"id":"/en/docs/development-api-214","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#static-pages","content":"`web_dist_dir()` locates `dist/` via `rvc_next.webui.__path__`, rather than the current directory or a hard-coded path, so both source checkouts and installed wheels can find it. `dist/` is git-ignored and bundled as package data (`\"rvc_next.webui\" = [\"dist/**/*\"]` in `pyproject.toml`) after `scripts/build_wheel.py` builds it.","locale":"en"},"8013":{"id":"/en/docs/development-api-215","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#static-pages","content":"`SPAStaticFiles` sends `Cache-Control: public, max-age=31536000, immutable` for files under `assets/` (Vite filenames contain content hashes and can be cached permanently); other files (mainly `index.html`) get `no-cache`, so browsers fetch the new entry point after upgrades.","locale":"en"},"8014":{"id":"/en/docs/development-api-216","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#static-pages","content":"Unknown paths fall back to `index.html` only when the request's `Accept` contains `text/html`. Misspelled asset or API paths still return 404 rather than HTML (fixing InvokeAI's fallback to index.html for every path). The frontend uses hash routing, so normal navigation does not need this fallback.","locale":"en"},"8015":{"id":"/en/docs/development-api-217","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"`rvc-next webui` (`cli/commands/webui.py`) runs in this order:","locale":"en"},"8016":{"id":"/en/docs/development-api-218","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"`build_services(start_background=True)`; take host, port, strict mode, and browser-opening behavior from CLI arguments, falling back to `server.*` settings (default `127.0.0.1:7868`).","locale":"en"},"8017":{"id":"/en/docs/development-api-219","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"Warn before binding to a non-loopback address (`server.access_token` is not required).","locale":"en"},"8018":{"id":"/en/docs/development-api-220","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"`bind_first_free_port(host, port, strict=…)` **binds the listening socket itself**: start at the configured port and try the next on `EADDRINUSE`/`EACCES` (and Windows equivalents), up to 20 ports, never beyond 65535; `strict` tries just one; port 0 lets the OS choose. On Windows set `SO_EXCLUSIVEADDRUSE` (prevent another process binding the same address and port); elsewhere set `SO_REUSEADDR` (allow quick restarts during `TIME_WAIT`). Exit (code 3) if all attempts fail.","locale":"en"},"8019":{"id":"/en/docs/development-api-221","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"`create_app(…, bound_host=host, bound_port=actual_port)`, `uvicorn.Server(config).run(sockets=[sock])`—pass **the same** socket to uvicorn.","locale":"en"},"8020":{"id":"/en/docs/development-api-222","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"Before running, write `server.json` (`host`, `port`, `url`, `pid`, atomically replaced via a temporary file), print `SERVER_READY url=http://…` to stdout, and open the browser after 0.8 s if configured; on exit, delete only the `server.json` written by this process (compare `pid`).","locale":"en"},"8021":{"id":"/en/docs/development-api-223","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"InvokeAI probes a port with `connect`, then lets uvicorn bind after services load. Probing only detects listening ports; Windows reserved port ranges, where nothing listens but binding is impossible, can appear free. The entire startup interval between probing and binding also lets another process take the port. Binding directly is the only reliable answer, and passing that exact socket to uvicorn removes the gap. The `SERVER_READY` line and `server.json` let launchers, scripts, and other programs discover port changes—log warnings are not machine-readable. `--strict-port` is for deployments with fixed port mappings (reverse proxies, containers), where silently changing ports would conceal the problem.","locale":"en"},"8022":{"id":"/en/docs/development-api-224","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#startup-ports-and-server_ready","content":"`read_runtime_file()` checks whether `pid` is alive and treats stale files as absent. The job service also uses it at startup to determine whether another live server owns the data directory (see Core services). In development, `scripts/dev.py dev` starts the API with `--no-open --strict-port` and has Vite proxy to it through `RVC_NEXT_BACKEND` (see Web UI).","locale":"en"},"8023":{"id":"/en/docs/development-api-225","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-an-endpoint","content":"Write a core method with `Record` parameters and return values; use existing error classes in `core/errors.py`.","locale":"en"},"8024":{"id":"/en/docs/development-api-226","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-an-endpoint","content":"Add a route in the appropriate `api/routers/<resource>.py`: set `operation_id`, use `ServicesDep` in the signature, and add `dependencies=[LocalDep]` for revealing files; use `spool` + `read_chunks` for uploads and declare `openapi_extra=RAW_BODY`. Put fixed paths before wildcard routes.","locale":"en"},"8025":{"id":"/en/docs/development-api-227","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-an-endpoint","content":"Return `Job` for long operations, with progress via events; if new push events are needed, add an `EventBase` subclass to `core/events/models.py` (automatically included in OpenAPI and `ServerEvents`) and handle it in frontend `api/socket.ts`.","locale":"en"},"8026":{"id":"/en/docs/development-api-228","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-an-endpoint","content":"If the CLI needs the same operation, call the same core method (see CLI implementation).","locale":"en"},"8027":{"id":"/en/docs/development-api-229","page_id":"/en/docs/development-api","tags":[],"type":"text","url":"/en/docs/development-api#adding-an-endpoint","content":"Run `python scripts/dev.py typegen` and commit `schema.d.ts` (plus `paramSpecs.ts` if parameter models changed); cover error mapping and permissions with `TestClient` in `tests/api/test_api.py`.","locale":"en"},"8028":{"id":"/en/docs/development-architecture","page_id":"/en/docs/development-architecture","type":"page","content":"Architecture","breadcrumbs":["RVC Next Documentation","Development"],"tags":[],"url":"/en/docs/development-architecture","locale":"en"},"8029":{"id":"/en/docs/development-architecture-0","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture","content":"The full picture of RVC Next: package structure and layer rules, service assembly, process responsibilities, a request's round trip from browser to engine, and shared infrastructure for errors, settings, events, the database and data directory.","locale":"en"},"8030":{"id":"/en/docs/development-architecture-1","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#layers","content":"Layers","locale":"en"},"8031":{"id":"/en/docs/development-architecture-2","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"Layer rules and their tests","locale":"en"},"8032":{"id":"/en/docs/development-architecture-3","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#one-operation-one-core-method","content":"One operation, one core method","locale":"en"},"8033":{"id":"/en/docs/development-architecture-4","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#assembly-build_services","content":"Assembly: `build_services()`","locale":"en"},"8034":{"id":"/en/docs/development-architecture-5","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#process-model","content":"Process model","locale":"en"},"8035":{"id":"/en/docs/development-architecture-6","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#worker-protocol","content":"Worker protocol","locale":"en"},"8036":{"id":"/en/docs/development-architecture-7","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#a-requests-path","content":"A request's path","locale":"en"},"8037":{"id":"/en/docs/development-architecture-8","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#errors-and-exit-codes","content":"Errors and exit codes","locale":"en"},"8038":{"id":"/en/docs/development-architecture-9","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#settings","content":"Settings","locale":"en"},"8039":{"id":"/en/docs/development-architecture-10","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#events","content":"Events","locale":"en"},"8040":{"id":"/en/docs/development-architecture-11","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#database","content":"Database","locale":"en"},"8041":{"id":"/en/docs/development-architecture-12","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#data-directory","content":"Data directory","locale":"en"},"8042":{"id":"/en/docs/development-architecture-13","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture","content":"This page gives the full picture of RVC Next: package structure and layer rules, service assembly, process responsibilities, a request's round trip from browser to engine, and shared infrastructure for errors, settings, events, the database and data directory. Each layer is covered in detail in Engine, Core services, API and events, Web UI and CLI implementation.","locale":"en"},"8043":{"id":"/en/docs/development-architecture-14","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`tests/test_architecture.py` uses `ast` to inspect each module's `import` statements (absolute imports only) against the table below; the standard library is always allowed.","locale":"en"},"8044":{"id":"/en/docs/development-architecture-15","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"Layer","locale":"en"},"8045":{"id":"/en/docs/development-architecture-16","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"Allowed `rvc_next` subpackages","locale":"en"},"8046":{"id":"/en/docs/development-architecture-17","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"Allowed third-party modules","locale":"en"},"8047":{"id":"/en/docs/development-architecture-18","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`engine`","locale":"en"},"8048":{"id":"/en/docs/development-architecture-19","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`engine`","locale":"en"},"8049":{"id":"/en/docs/development-architecture-20","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"numpy, scipy, torch, transformers, faiss, parselmouth, librosa, av, soundfile, onnxruntime, torch_directml, tensorboard, plus `sounddevice` (only under `engine/audio_io/`), `pymss` and `pymss_core` (only under `engine/separate/`), `yaml`","locale":"en"},"8050":{"id":"/en/docs/development-architecture-21","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`protocol`","locale":"en"},"8051":{"id":"/en/docs/development-architecture-22","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`protocol`","locale":"en"},"8052":{"id":"/en/docs/development-architecture-23","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"None","locale":"en"},"8053":{"id":"/en/docs/development-architecture-24","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`workers`","locale":"en"},"8054":{"id":"/en/docs/development-architecture-25","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`engine`, `protocol`, `workers`","locale":"en"},"8055":{"id":"/en/docs/development-architecture-26","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"Same as engine, plus `sounddevice`, `pymss`, `yaml`","locale":"en"},"8056":{"id":"/en/docs/development-architecture-27","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`core`","locale":"en"},"8057":{"id":"/en/docs/development-architecture-28","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`core`, `engine`, `protocol`, `version`, `logger`","locale":"en"},"8058":{"id":"/en/docs/development-architecture-29","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"pydantic, httpx, tomli, tomli_w, send2trash, numpy, typing_extensions","locale":"en"},"8059":{"id":"/en/docs/development-architecture-30","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`api`","locale":"en"},"8060":{"id":"/en/docs/development-architecture-31","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`api`, `core`, `version`, `logger`, `webui`","locale":"en"},"8061":{"id":"/en/docs/development-architecture-32","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"fastapi, starlette, socketio, uvicorn, pydantic, anyio","locale":"en"},"8062":{"id":"/en/docs/development-architecture-33","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`cli`","locale":"en"},"8063":{"id":"/en/docs/development-architecture-34","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"`cli`, `core`, `version`, `logger`, `api`","locale":"en"},"8064":{"id":"/en/docs/development-architecture-35","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"typer, click, rich, pydantic, uvicorn","locale":"en"},"8065":{"id":"/en/docs/development-architecture-36","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"Two additional subprocess tests check that importing `rvc_next.core.context` does not load `torch`, and that importing `rvc_next.cli.app` loads neither `torch` nor `fastapi`.","locale":"en"},"8066":{"id":"/en/docs/development-architecture-37","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"Each rule has a purpose:","locale":"en"},"8067":{"id":"/en/docs/development-architecture-38","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"**The engine knows nothing about the application.** It imports neither core, any Web / CLI framework, nor pydantic; parameters are frozen dataclasses (`VoiceParams`, `StreamParams`). Worker subprocesses and tests can therefore drive the engine directly, while core's `Record` models are the sole API shape. One problem in the original was that the engine returned Gradio update dictionaries and Chinese status text, making it unusable outside the UI.","locale":"en"},"8068":{"id":"/en/docs/development-architecture-39","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"**Core imports no frameworks and never imports torch directly.** All 51 of its engine imports are inside functions. Commands such as `rvc-next version`, `config` and `--help` therefore avoid the cost of loading torch; the second test protects this.","locale":"en"},"8069":{"id":"/en/docs/development-architecture-40","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"**`sounddevice` and `pymss` are confined to their own directories**, keeping changes to device access and the separation library local.","locale":"en"},"8070":{"id":"/en/docs/development-architecture-41","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"**`protocol` uses only the standard library**, because both sides share it: the server and worker subprocesses must be able to import it without pulling in each other's dependencies.","locale":"en"},"8071":{"id":"/en/docs/development-architecture-42","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#layer-rules-and-their-tests","content":"**`api` and `cli` never import `engine`.** The only import across interfaces is the `webui` command in `cli` importing `rvc_next.api.app.create_app` inside its function to start the server; the rule table allows `cli → api` and `uvicorn` for this.","locale":"en"},"8072":{"id":"/en/docs/development-architecture-43","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#one-operation-one-core-method","content":"Each operation has exactly one core method, accepting and returning `Record` models (`core/record.py`). Routes and commands do only three things: parse input, call that method and shape the output. For conversion, the route body in `api/routers/convert.py` only checks access to server paths, rejects CLI-only fields, then calls `return services.conversion.convert(body)`; the CLI's `convert` command constructs the same `ConvertRequest` and calls the same method (`foreground=True`).","locale":"en"},"8073":{"id":"/en/docs/development-architecture-44","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#one-operation-one-core-method","content":"The API's JSON and CLI's `--json` output therefore have exactly the same shape: `test_model_json_matches_api_shape` in `tests/cli/test_cli.py` directly compares `rvc-next model list --json` with `GET /api/v1/models`. `Record` sets `json_schema_serialization_defaults_required`, marking defaulted fields as required in the output schema, so the generated TypeScript types match what the server actually sends.","locale":"en"},"8074":{"id":"/en/docs/development-architecture-45","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`build_services()` in `core/context.py` constructs all services once in dependency order and returns a `Services` dataclass:","locale":"en"},"8075":{"id":"/en/docs/development-architecture-46","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Field","locale":"en"},"8076":{"id":"/en/docs/development-architecture-47","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Class","locale":"en"},"8077":{"id":"/en/docs/development-architecture-48","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"Responsibility","locale":"en"},"8078":{"id":"/en/docs/development-architecture-49","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`settings`","locale":"en"},"8079":{"id":"/en/docs/development-architecture-50","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`SettingsService`","locale":"en"},"8080":{"id":"/en/docs/development-architecture-51","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`settings.toml`, environment overrides, resolved directories","locale":"en"},"8081":{"id":"/en/docs/development-architecture-52","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`events`","locale":"en"},"8082":{"id":"/en/docs/development-architecture-53","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"`LocalEventBus`","locale":"en"},"8083":{"id":"/en/docs/development-architecture-54","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#assembly-build_services","content":"In-process publish / subscribe","locale":"en"},"8084":{"id":"/en/docs/develo